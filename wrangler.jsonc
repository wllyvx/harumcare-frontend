{
  "main": "dist/_worker.js/index.js",
  "name": "harumcare-frontend",
  "compatibility_date": "2026-01-23",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "951723270938-c5bad61epvrs57qbgb5drau4btc0dke6.apps.googleusercontent.com"
  },
  "routes": [
    {
      "pattern": "www.harumcare.com",
      "custom_domain": true
    },
    {
      "pattern": "harumcare.com",
      "custom_domain": true
    }
  ]
}