---
import PrimaryLayout from "../../layouts/PrimaryLayout.astro";
import FAQ from "../../components/about/FAQ.astro";
---

<>
    <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL@20..48,100..700,0..1"
    />
</>

<PrimaryLayout>
    <main>
        <!-- Hero Section -->
        <section class="relative w-full overflow-hidden">
            <div class="max-w-300 mx-auto px-6 py-10">
                <div class="@container">
                    <div
                        class="flex min-h-130 flex-col gap-6 bg-cover bg-center bg-no-repeat rounded-xl items-center justify-center p-8 text-center"
                        style='background-image: linear-gradient(rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.7) 100%), url("https://images.unsplash.com/photo-1559027615-cd2628902d4a?w=1200&h=520&fit=crop")'
                    >
                        <div class="flex flex-col gap-4 max-w-2xl">
                            <h1
                                class="text-white text-4xl font-black leading-tight tracking-tight @[480px]:text-6xl"
                            >
                                Membangun Masa Depan Bersama
                            </h1>
                            <p
                                class="text-white/90 text-base @[480px]:text-xl font-normal leading-relaxed"
                            >
                                Harum Care Indonesia berkomitmen untuk
                                memberikan solusi digital terbaik dalam membantu
                                Anda mengelola zakat dan amal dengan mudah dan
                                transparan.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Our Story Section -->
        <section
            class="max-w-300 mx-auto px-6 py-16 grid md:grid-cols-2 gap-12 items-center"
        >
            <div>
                <h2
                    class="text-primary text-sm font-bold uppercase tracking-widest mb-2"
                >
                    Sejarah Kami
                </h2>
                <h3 class="text-3xl md:text-4xl font-bold mb-6 leading-tight">
                    Perjalanan Kami dalam Pelayanan Digital
                </h3>
                <p class="text-lg text-gray-600 mb-4 leading-relaxed">
                    HARUM Care Indonesia adalah sub-divisi dari Yayasan Dakwah &
                    Sosial Harapan Umat Karawang. Bidang yang berfokus pada
                    ranah sosial kemanusiaan (filantropi), baik dalam skala
                    nasional maupun internasional. Yayasan Harapan Umat yang
                    kemudian disingkat dengan yayasan HARUM, sedari awal berdiri
                    sebagai lembaga yang berakar pada dunia pendidikan, saat ini
                    mengelola jenjang pendidikan dari level TKIT sampai dengan
                    SMAIT, hingga boarding school, dengan jumlah peserta didik
                    sebanyak 1800 siswa, dan karyawan 249 orang. Bermuara dari
                    lembaga pendidikan inilah HARUM Care Indonesia lahir, tumbuh
                    dan berkembang atas dukungan dan sinergi dari pengurus
                    yayasan, karyawan, orang tua siswa, serta organisasi komite
                    sekolah. Sinergi inilah yang menjadi modal kuat dalam
                    menggerakkan berbagai program sosial kemanusiaan. Dengan
                    izin resmi dari Dinas Sosial, sekaligus sebagai Unit
                    Pengumpul Zakat (UPZ) resmi dari BAZNAS, Harum Care
                    Indonesia berkomitmen menjadi wadah yang menghimpun,
                    mengelola, dan menyalurkan potensi kebaikan agar manfaatnya
                    dapat dirasakan oleh masyarakat secara luas dan
                    berkelanjutan.
                </p>
            </div>
            <div
                class="rounded-xl overflow-hidden shadow-2xl rotate-2 hover:rotate-0 transition-transform duration-500"
            >
                <img
                    alt="HarumCare Team"
                    class="w-full h-100 object-cover"
                    src="https://images.unsplash.com/photo-1552664730-d307ca884978?w=500&h=400&fit=crop"
                />
            </div>
        </section>

        <!-- Vision & Mission Section -->
        <section class="bg-white py-20 border-y border-[#dbe6e1]">
            <div class="max-w-300 mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="text-3xl font-bold">Visi & Misi Kami</h2>
                    <div class="h-1 w-20 bg-primary mx-auto mt-4 rounded-full">
                    </div>
                </div>
                <div class="grid md:grid-cols-2 gap-8">
                    <div
                        class="flex flex-col gap-4 rounded-xl border border-[#dbe6e1] bg-background-light p-8 hover:shadow-lg transition-shadow"
                    >
                        <div
                            class="bg-primary/20 w-14 h-14 rounded-lg flex items-center justify-center text-primary"
                        >
                            <span class="material-symbols-outlined text-3xl"
                                >visibility</span
                            >
                        </div>
                        <h2 class="text-2xl font-bold leading-tight">Visi</h2>
                        <p class="text-gray-600 text-lg leading-normal">
                            Menjadi organisasi kerelawanan dan kedermawanan
                            masyarakat yang profesional, amanah, dan berbasis
                            kebaikan untuk mewujudkan kehidupan sosial
                            kemasyarakatan yang lebih manusiawi.
                        </p>
                    </div>
                    <div
                        class="flex flex-col gap-4 rounded-xl border border-[#dbe6e1] bg-background-light p-8 hover:shadow-lg transition-shadow"
                    >
                        <div
                            class="bg-primary/20 w-14 h-14 rounded-lg flex items-center justify-center text-primary"
                        >
                            <span class="material-symbols-outlined text-3xl"
                                >track_changes</span
                            >
                        </div>
                        <h2 class="text-2xl font-bold leading-tight">Misi</h2>
                        <ul
                            class="text-gray-600 text-lg leading-relaxed space-y-2"
                        >
                            <li class="flex items-start gap-2">
                                <span
                                    class="text-primary mt-1 material-symbols-outlined text-sm"
                                    >check_circle</span
                                > Menangani persoalan kemanusiaan secara terencana
                                dan berkelanjutan di tingkat lokal hingga global.
                            </li>
                            <li class="flex items-start gap-2">
                                <span
                                    class="text-primary mt-1 material-symbols-outlined text-sm"
                                    >check_circle</span
                                > Menghimpun dan menyalurkan potensi kedermawanan
                                masyarakat untuk membantu sesama.
                            </li>
                            <li class="flex items-start gap-2">
                                <span
                                    class="text-primary mt-1 material-symbols-outlined text-sm"
                                    >check_circle</span
                                > Menggerakkan potensi kerelawanan sebagai kekuatan
                                sosial dalam aksi kemanusiaan.
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- Legalitas Section -->
        <section class="max-w-300 mx-auto px-6 py-20">
            <div class="text-center mb-16">
                <h2 class="text-3xl font-bold">Legalitas</h2>
                <p class="text-gray-500 mt-2">
                    Dokumen resmi yang mengesahkan operasional HarumCare
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- SK Kemenkumham -->
                <div
                    class="flex flex-col gap-4 rounded-xl border border-[#dbe6e1] bg-white p-6 hover:shadow-lg transition-shadow"
                >
                    <div
                        class="bg-primary/20 w-14 h-14 rounded-lg flex items-center justify-center text-primary mb-2"
                    >
                        <span class="material-symbols-outlined text-3xl"
                            >contract</span
                        >
                    </div>
                    <h3 class="text-xl font-bold">SK Kemenkumham</h3>
                    <p class="text-gray-600 flex-grow text-sm">
                        Surat Keputusan Kementerian Hukum dan Hak Asasi Manusia
                        Republik Indonesia tentang pengesahan badan hukum
                        yayasan.
                    </p>
                    <a
                        href="https://drive.google.com/uc?export=download&id=1VlHntFJgG3imfxi3gfsQrefV6ti6Uysv"
                        target="_blank"
                        class="mt-2 flex items-center gap-2 text-primary font-bold hover:underline group w-fit"
                    >
                        <span
                            class="material-symbols-outlined text-xl group-hover:-translate-y-1 transition-transform"
                            >download</span
                        >
                        <span>Unduh Dokumen</span>
                    </a>
                </div>

                <!-- SK BAZNAS -->
                <div
                    class="flex flex-col gap-4 rounded-xl border border-[#dbe6e1] bg-white p-6 hover:shadow-lg transition-shadow"
                >
                    <div
                        class="bg-primary/20 w-14 h-14 rounded-lg flex items-center justify-center text-primary mb-2"
                    >
                        <span class="material-symbols-outlined text-3xl"
                            >verified</span
                        >
                    </div>
                    <h3 class="text-xl font-bold">SK BAZNAS</h3>
                    <p class="text-gray-600 flex-grow text-sm">
                        Surat Keputusan Badan Amil Zakat Nasional (BAZNAS)
                        sebagai Unit Pengumpul Zakat (UPZ) resmi yang diwakili
                        oleh Harum Care.
                    </p>
                    <a
                        href="#"
                        target="_blank"
                        class="mt-2 flex items-center gap-2 text-primary font-bold hover:underline group w-fit"
                    >
                        <span
                            class="material-symbols-outlined text-xl group-hover:-translate-y-1 transition-transform"
                            >download</span
                        >
                        <span>Unduh Dokumen</span>
                    </a>
                </div>

                <!-- SK Dinsos -->
                <div
                    class="flex flex-col gap-4 rounded-xl border border-[#dbe6e1] bg-white p-6 hover:shadow-lg transition-shadow"
                >
                    <div
                        class="bg-primary/20 w-14 h-14 rounded-lg flex items-center justify-center text-primary mb-2"
                    >
                        <span class="material-symbols-outlined text-3xl"
                            >handshake</span
                        >
                    </div>
                    <h3 class="text-xl font-bold">SK Dinsos</h3>
                    <p class="text-gray-600 flex-grow text-sm">
                        Surat Keputusan Dinas Sosial terkait izin operasional
                        lembaga yang bergerak di bidang sosial kemasyarakatan.
                    </p>
                    <a
                        href="#"
                        target="_blank"
                        class="mt-2 flex items-center gap-2 text-primary font-bold hover:underline group w-fit"
                    >
                        <span
                            class="material-symbols-outlined text-xl group-hover:-translate-y-1 transition-transform"
                            >download</span
                        >
                        <span>Unduh Dokumen</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- Team Section -->
        <section class="bg-white py-20">
            <div class="max-w-300 mx-auto px-6 text-center">
                <h2 class="text-3xl font-bold mb-12">Tim Kami</h2>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
                    <div class="group">
                        <div
                            class="aspect-square rounded-xl overflow-hidden mb-4 relative bg-gray-300 flex items-center justify-center"
                        >
                            <span
                                class="material-symbols-outlined text-6xl text-gray-500"
                                >account_circle</span
                            >
                        </div>
                        <h4 class="font-bold text-lg">Ridwan, Lc., M.Pd.I.</h4>
                        <p class="text-primary text-sm font-medium">Founder</p>
                    </div>
                    <div class="group">
                        <div
                            class="aspect-square rounded-xl overflow-hidden mb-4 relative bg-gray-300 flex items-center justify-center"
                        >
                            <span
                                class="material-symbols-outlined text-6xl text-gray-500"
                                >account_circle</span
                            >
                        </div>
                        <h4 class="font-bold text-lg">
                            M. Basith Ayyasyi Suhenda, S.T.
                        </h4>
                        <p class="text-primary text-sm font-medium">Program</p>
                    </div>
                    <div class="group">
                        <div
                            class="aspect-square rounded-xl overflow-hidden mb-4 relative bg-gray-300 flex items-center justify-center"
                        >
                            <span
                                class="material-symbols-outlined text-6xl text-gray-500"
                                >account_circle</span
                            >
                        </div>
                        <h4 class="font-bold text-lg">
                            Willy Fajar Ramadhan, S.Kom.
                        </h4>
                        <p class="text-primary text-sm font-medium">
                            Multimedia
                        </p>
                    </div>
                    <div class="group">
                        <div
                            class="aspect-square rounded-xl overflow-hidden mb-4 relative bg-gray-300 flex items-center justify-center"
                        >
                            <span
                                class="material-symbols-outlined text-6xl text-gray-500"
                                >account_circle</span
                            >
                        </div>
                        <h4 class="font-bold text-lg">Nama Tim</h4>
                        <p class="text-primary text-sm font-medium">
                            Community Manager
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Values Section -->
        <section class="max-w-300 mx-auto px-6 py-20 border-t border-[#dbe6e1]">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold">Nilai-Nilai Kami</h2>
                <p class="text-gray-500 mt-2">
                    Prinsip yang memandu setiap keputusan kami
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div
                    class="p-6 bg-white border border-[#dbe6e1] rounded-lg flex flex-col items-start hover:shadow-lg transition-shadow"
                >
                    <span
                        class="material-symbols-outlined text-4xl text-primary mb-4"
                        >verified_user</span
                    >
                    <h5 class="font-bold text-lg mb-2">Transparansi</h5>
                    <p class="text-gray-600">
                        Kami berkomitmen memberikan laporan lengkap tentang
                        setiap transaksi dan penggunaan dana.
                    </p>
                </div>
                <div
                    class="p-6 bg-white border border-[#dbe6e1] rounded-lg flex flex-col items-start hover:shadow-lg transition-shadow"
                >
                    <span
                        class="material-symbols-outlined text-4xl text-primary mb-4"
                        >security</span
                    >
                    <h5 class="font-bold text-lg mb-2">Keamanan</h5>
                    <p class="text-gray-600">
                        Data dan transaksi Anda dilindungi dengan enkripsi
                        tingkat enterprise dan standar keamanan internasional.
                    </p>
                </div>
                <div
                    class="p-6 bg-white border border-[#dbe6e1] rounded-lg flex flex-col items-start hover:shadow-lg transition-shadow"
                >
                    <span
                        class="material-symbols-outlined text-4xl text-primary mb-4"
                        >favorite</span
                    >
                    <h5 class="font-bold text-lg mb-2">Kepedulian</h5>
                    <p class="text-gray-600">
                        Kami peduli dengan dampak sosial dan terus berinovasi
                        untuk meningkatkan layanan kami.
                    </p>
                </div>
            </div>
        </section>

        <FAQ />

        <!-- CTA Section -->
        <section class="max-w-300 mx-auto px-6 pb-20">
            <div
                class="bg-primary rounded-2xl p-10 md:p-16 text-[#111815] flex flex-col md:flex-row items-center justify-between gap-8"
            >
                <div class="max-w-xl">
                    <h2 class="text-3xl font-black mb-4">Siap Memulai?</h2>
                    <p class="text-lg font-medium opacity-80">
                        Bergabunglah dengan ribuan pengguna yang telah merasakan
                        kemudahan dalam menghitung dan membayar zakat.
                    </p>
                </div>
                <div class="flex flex-col sm:flex-row gap-4 w-full md:w-auto">
                    <button
                        class="bg-[#111815] text-white px-8 py-4 rounded-xl font-bold hover:bg-[#111815]/90 transition-all whitespace-nowrap"
                        >Mulai Sekarang</button
                    >
                    <button
                        class="bg-white text-[#111815] border-2 border-transparent px-8 py-4 rounded-xl font-bold hover:bg-transparent hover:border-[#111815] transition-all whitespace-nowrap"
                        >Pelajari Lebih Lanjut</button
                    >
                </div>
            </div>
        </section>
    </main>
</PrimaryLayout>
