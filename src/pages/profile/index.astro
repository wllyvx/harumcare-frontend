---
// Layout untuk halaman profil
import PrimaryLayout from "../../layouts/PrimaryLayout.astro";
import Button from "../../components/common/Button.astro";
---

<PrimaryLayout title="Profil - Harum Care Indonesia">
  <div id="profile-container" class="min-h-screen bg-[#f8fafc]">
    <div
      id="loading-state"
      class="flex items-center justify-center min-h-[calc(100vh-200px)]"
      role="status"
      aria-live="polite"
    >
      <div class="text-center">
        <div
          class="animate-spin rounded-full h-12 w-12 border-[3px] border-brand-100 border-t-brand-600 mx-auto mb-4"
          aria-hidden="true"
        >
        </div>
        <p class="text-sm font-medium text-muted-foreground tracking-wide">Memuat profil...</p>
      </div>
    </div>

    <div
      id="error-state"
      class="hidden flex items-center justify-center min-h-[calc(100vh-200px)] p-4"
      role="alert"
    >
      <div
        class="max-w-md w-full bg-white rounded-2xl shadow-[0_8px_32px_rgba(15,23,42,0.08)] border border-border p-8 text-center"
      >
        <div
          class="w-16 h-16 bg-red-50 rounded-2xl flex items-center justify-center mx-auto mb-5 ring-1 ring-red-100"
          aria-hidden="true"
        >
          <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        </div>
        <h3 id="error-title" class="text-xl font-semibold tracking-tight text-foreground mb-2">Terjadi Kesalahan</h3>
        <p id="error-message" class="text-[15px] leading-relaxed text-muted-foreground mb-8 text-balance">
          Maaf, kami gagal memuat data profil Anda. Ini mungkin karena sesi Anda telah berakhir atau masalah koneksi.
        </p>
        <div id="error-actions" class="space-y-3">
          <button
            onclick="window.location.reload()"
            class="block w-full bg-brand-600 hover:bg-brand-700 text-white font-semibold py-3 px-6 rounded-button transition-colors duration-200 shadow-[0_4px_16px_rgba(37,99,235,0.25)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2"
          >Coba Lagi</button>
        </div>
      </div>
    </div>

    <div id="profile-content" class="hidden">
      <div class="bg-white/80 backdrop-blur-sm border-b border-border sticky top-16 z-30">
        <div class="container mx-auto px-4 py-3.5">
          <div class="flex items-center gap-3">
            <a href="/" class="inline-flex items-center justify-center w-9 h-9 rounded-button border border-border bg-white hover:bg-gray-50 text-muted-foreground hover:text-foreground transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600" aria-label="Kembali ke beranda">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            </a>
            <div>
              <h1 class="text-[15px] font-semibold tracking-tight text-foreground leading-none">Profil Saya</h1>
              <p class="text-xs text-muted-foreground mt-1 hidden sm:block">Kelola informasi akun dan riwayat donasi</p>
            </div>
          </div>
        </div>
      </div>

      <div class="container mx-auto px-4 py-6 md:py-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
          <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-[88px]">
            <div class="bg-white rounded-card shadow-[0_4px_20px_rgba(15,23,42,0.06)] border border-border overflow-hidden">
              <div class="p-6">
                <div class="flex items-start gap-4">
                  <div class="w-16 h-16 md:w-20 md:h-20 bg-brand-50 border border-brand-100 rounded-2xl flex items-center justify-center shrink-0" aria-hidden="true">
                    <svg class="w-8 h-8 md:w-10 md:h-10 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-start justify-between gap-2">
                      <div class="min-w-0">
                        <h2 id="user-name" class="text-lg font-semibold tracking-tight text-foreground leading-tight truncate">Loading...</h2>
                        <p id="user-role" class="inline-flex items-center mt-1.5 text-xs font-medium px-2 py-1 rounded-full bg-gray-100 text-muted-foreground border border-border">Loading...</p>
                      </div>
                      <button
                        id="edit-profile-inline"
                        class="hidden shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-button border border-border bg-white hover:bg-gray-50 text-brand-600 hover:text-brand-700 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2"
                        aria-label="Edit profil"
                        type="button"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5M16 3l5 5M7 11l6 6"></path></svg>
                      </button>
                    </div>
                  </div>
                </div>

                <dl class="mt-6 space-y-4">
                  <div class="flex flex-col gap-1">
                    <dt class="text-xs font-medium tracking-wide uppercase text-muted-foreground">Nama</dt>
                    <dd id="user-fullname" class="text-sm font-medium text-foreground break-words">-</dd>
                  </div>
                  <div class="flex flex-col gap-1">
                    <dt class="text-xs font-medium tracking-wide uppercase text-muted-foreground">Username</dt>
                    <dd id="user-username" class="text-sm font-medium text-foreground break-all">-</dd>
                  </div>
                  <div class="flex flex-col gap-1">
                    <dt class="text-xs font-medium tracking-wide uppercase text-muted-foreground">Email</dt>
                    <dd id="user-email" class="text-sm font-medium text-foreground break-all">-</dd>
                  </div>
                  <div class="flex flex-col gap-1">
                    <dt class="text-xs font-medium tracking-wide uppercase text-muted-foreground">Nomor HP</dt>
                    <dd id="user-phone" class="text-sm font-medium text-foreground">-</dd>
                  </div>
                  <div class="flex flex-col gap-1">
                    <dt class="text-xs font-medium tracking-wide uppercase text-muted-foreground">Alamat</dt>
                    <dd id="user-address" class="text-sm leading-relaxed text-foreground break-words">-</dd>
                  </div>
                </dl>
              </div>
            </div>

            <div id="action-buttons" class="space-y-3">
            </div>
          </div>

          <div class="lg:col-span-8 space-y-6">
            <div class="bg-white rounded-card shadow-[0_4px_20px_rgba(15,23,42,0.06)] border border-border p-6 md:p-7">
              <div class="flex items-center justify-between gap-4 mb-5">
                <h3 class="text-base font-semibold tracking-tight text-foreground">Riwayat Donasi</h3>
                <span class="hidden sm:inline-flex items-center gap-1.5 text-xs text-muted-foreground"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> Sinkron otomatis</span>
              </div>
              <div id="donation-summary-container">
                <div class="bg-gray-50/80 rounded-xl border border-border p-6 text-center">
                  <p id="donation-summary-text" class="text-sm leading-relaxed text-muted-foreground mb-4">Memuat ringkasan riwayat donasi...</p>
                  <Button asChild variant="default">
                    <a href="/profile/donations" class="inline-flex w-full md:w-auto justify-center">Lihat Semua Riwayat Donasi</a>
                  </Button>
                </div>
              </div>
            </div>

            <div id="login-prompt" class="hidden bg-white rounded-card shadow-[0_4px_20px_rgba(15,23,42,0.06)] border border-border p-8">
              <div class="text-center max-w-sm mx-auto">
                <div class="w-14 h-14 bg-gray-100 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-border" aria-hidden="true">
                  <svg class="w-7 h-7 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                </div>
                <h3 class="text-base font-semibold tracking-tight text-foreground mb-1.5">Anda Belum Masuk</h3>
                <p class="text-sm leading-relaxed text-muted-foreground mb-6 text-balance">Silakan masuk ke akun Anda untuk melihat profil lengkap dan mengakses fitur lainnya.</p>
                <div class="space-y-3">
                  <a href="/auth/login" class="w-full bg-brand-600 text-white py-3 px-4 rounded-button hover:bg-brand-700 transition-colors duration-200 font-medium text-center block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2">Masuk ke Akun</a>
                  <p class="text-sm text-muted-foreground">Belum punya akun? <a href="/auth/signup" class="text-brand-600 hover:text-brand-700 font-medium underline underline-offset-4">Daftar di sini</a></p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div id="edit-modal" class="fixed inset-0 hidden items-center justify-center z-50 p-4" role="dialog" aria-modal="true" aria-labelledby="edit-modal-title">
          <div class="absolute inset-0 bg-gray-900/40 backdrop-blur-sm" id="edit-modal-backdrop"></div>
          <div class="bg-white rounded-card shadow-[0_16px_48px_rgba(15,23,42,0.16)] max-w-lg w-full p-6 md:p-7 z-10 border border-border max-h-[90vh] overflow-auto">
            <h3 id="edit-modal-title" class="text-lg font-semibold tracking-tight text-foreground mb-5">Edit Profil</h3>
            <form id="edit-profile-form" class="space-y-4" novalidate>
              <div>
                <label for="input-nama" class="block text-sm font-medium text-foreground mb-1.5">Nama</label>
                <input id="input-nama" name="nama" type="text" autocomplete="name" class="w-full border border-input bg-white p-3 rounded-button text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-brand-600 focus:border-brand-600 transition-colors" placeholder="Nama lengkap" />
              </div>
              <div>
                <label for="input-email" class="block text-sm font-medium text-foreground mb-1.5">Email</label>
                <input id="input-email" name="email" type="email" autocomplete="email" class="w-full border border-input bg-white p-3 rounded-button text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-brand-600 focus:border-brand-600 transition-colors" placeholder="nama@email.com" />
              </div>
              <div>
                <label for="input-phone" class="block text-sm font-medium text-foreground mb-1.5">Nomor HP</label>
                <input id="input-phone" name="nomorHp" type="tel" autocomplete="tel" inputmode="numeric" class="w-full border border-input bg-white p-3 rounded-button text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-brand-600 focus:border-brand-600 transition-colors" placeholder="08xxxxxxxxxx" />
              </div>
              <div>
                <label for="input-address" class="block text-sm font-medium text-foreground mb-1.5">Alamat</label>
                <textarea id="input-address" name="alamat" autocomplete="street-address" class="w-full border border-input bg-white p-3 rounded-button text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-brand-600 focus:border-brand-600 transition-colors resize-none" rows="3" placeholder="Alamat lengkap"></textarea>
              </div>
              <div class="flex justify-end items-center gap-3 pt-2">
                <Button id="cancel-edit" variant="outline" type="button">Batal</Button>
                <Button type="submit" id="save-edit" variant="default">Simpan</Button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const API_URL = import.meta.env.PUBLIC_API_URL;

    function showElement(el) {
      if (el) el.classList.remove("hidden");
    }
    function hideElement(el) {
      if (el) el.classList.add("hidden");
    }

    /**
     * @param {string} title
     * @param {string} message
     * @param {boolean} isSessionError
     */
    function showError(title, message, isSessionError = false) {
      const loadingState = document.querySelector("#loading-state");
      const profileContent = document.querySelector("#profile-content");
      const errorState = document.querySelector("#error-state");
      const errorTitle = document.querySelector("#error-title");
      const errorMessage = document.querySelector("#error-message");
      const errorActions = document.querySelector("#error-actions");

      hideElement(loadingState);
      hideElement(profileContent);
      showElement(errorState);

      if (errorTitle) errorTitle.textContent = title;
      if (errorMessage) errorMessage.textContent = message;

      if (isSessionError && errorActions) {
        errorActions.innerHTML = `
          <a
            href="/auth/login"
            class="block w-full bg-brand-600 hover:bg-brand-700 text-white font-semibold py-3 px-6 rounded-button transition-colors duration-200 shadow-[0_4px_16px_rgba(37,99,235,0.25)] text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2"
          >
            Masuk Kembali
          </a>
          <button
            onclick="window.location.reload()"
            class="block w-full bg-white hover:bg-gray-50 text-foreground font-medium py-3 px-6 rounded-button border border-input transition-colors duration-200 text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2"
          >
            Coba Lagi
          </button>
        `;
      }
    }

    // Cek status login dan load profil ringkas
    function checkAuthStatus() {
      const token = localStorage.getItem("token");
      const role = localStorage.getItem("role");

      const loadingState = document.querySelector("#loading-state");
      const profileContent = document.querySelector("#profile-content");
      const actionButtons = document.querySelector("#action-buttons");
      const loginPrompt = document.querySelector("#login-prompt");
      const errorState = document.querySelector("#error-state");

      if (
        !loadingState ||
        !profileContent ||
        !actionButtons ||
        !loginPrompt ||
        !errorState
      ) {
        console.error("Required elements not found");
        return;
      }

      if (token) {
        hideElement(loadingState);
        showElement(profileContent);
        hideElement(loginPrompt);
        hideElement(errorState);

        // Fetch full profile from server
        fetchUserProfile(token).catch((e) => {
          console.error(e);
          showError(
            "Gagal Memuat Profil",
            e.message || "Terjadi kesalahan saat mengambil data profil.",
          );
        });

        // Fetch donation summary (compact)
        fetchDonationSummary(token).catch((e) => console.error(e));
      } else {
        hideElement(loadingState);
        showElement(profileContent);
        showElement(loginPrompt);
        hideElement(errorState);

        const userNameElement = document.querySelector("#user-name");
        const userRoleElement = document.querySelector("#user-role");
        const userEmailElement = document.querySelector("#user-email");

        if (userNameElement) userNameElement.textContent = "Pengunjung";
        if (userRoleElement)
          userRoleElement.textContent = "Belum masuk ke akun";
        if (userEmailElement)
          userEmailElement.textContent =
            "Silakan masuk untuk melihat profil lengkap";

        actionButtons.innerHTML = "";
      }
    }

    async function fetchUserProfile(token) {
      try {
        const res = await fetch(`${API_URL}/auth/profile`, {
          headers: { Authorization: `Bearer ${token}` },
        });

        const text = await res.text();
        let parsed;
        try {
          parsed = JSON.parse(text);
        } catch (e) {
          parsed = text;
        }

        if (!res.ok) {
          // Special handling for auth errors
          if (res.status === 401 || res.status === 403) {
            // clear token to force re-login
            console.warn(
              "Authentication failed when fetching profile. Clearing token.",
            );
            localStorage.removeItem("token");
            localStorage.removeItem("role");
            showError(
              "Sesi Berakhir",
              "Sesi Anda telah berakhir. Silakan masuk kembali untuk mengakses halaman profil.",
              true,
            );
            return;
          }
          throw new Error(parsed?.error || "Gagal mengambil profil");
        }

        const user = typeof parsed === "object" ? parsed : JSON.parse(text);

        // Update DOM
        const nameHeading = document.querySelector("#user-name");
        const roleEl = document.querySelector("#user-role");
        const fullName = document.querySelector("#user-fullname");
        const usernameEl = document.querySelector("#user-username");
        const emailEl = document.querySelector("#user-email");
        const phoneEl = document.querySelector("#user-phone");
        const addressEl = document.querySelector("#user-address");
        const editInlineBtn = document.querySelector("#edit-profile-inline");

        if (nameHeading) nameHeading.textContent = user.nama || "User";
        if (roleEl)
          roleEl.textContent = user.role === "admin" ? "Administrator" : "User";
        if (fullName) fullName.textContent = user.nama || "-";
        if (usernameEl) usernameEl.textContent = user.username || "-";
        if (emailEl) emailEl.textContent = user.email || "-";
        if (phoneEl) phoneEl.textContent = user.nomorHp || "-";
        if (addressEl) addressEl.textContent = user.alamat || "-";

        // Save for receipt generator if needed
        if (user.nama) localStorage.setItem("userName", user.nama);
        if (user.email) localStorage.setItem("userEmail", user.email);

        // Show inline edit button
        if (editInlineBtn) editInlineBtn.classList.remove("hidden");

        // Render action buttons (logout/admin/edit)
        renderActionButtons(user.role || "user");
      } catch (err) {
        console.error("fetchUserProfile error:", err);
        showError(
          "Gagal Memuat Profil",
          err.message ||
            "Terjadi kesalahan yang tidak terduga saat mengambil data profil.",
        );
      }
    }

    function renderActionButtons(role) {
      const actionButtons = document.querySelector("#action-buttons");
      if (!actionButtons) return;
      actionButtons.innerHTML = "";

      const box = document.createElement("div");
      box.className = "bg-white rounded-card shadow-[0_4px_20px_rgba(15,23,42,0.06)] border border-border p-5";

      const title = document.createElement("h3");
      title.className = "text-sm font-semibold tracking-tight text-foreground mb-3";
      title.textContent = "Aksi Cepat";
      box.appendChild(title);

      const list = document.createElement("div");
      list.className = "space-y-2.5";

      const editBtn = document.createElement("button");
      editBtn.id = "open-edit-btn";
      editBtn.type = "button";
      editBtn.className = "w-full inline-flex items-center justify-center gap-2 bg-white border border-input text-foreground py-2.5 px-4 rounded-button hover:bg-gray-50 transition-colors text-sm font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2";
      editBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5M16 3l5 5M7 11l6 6" /></svg> Edit Profil';
      list.appendChild(editBtn);

      if (role === "admin") {
        const adminLink = document.createElement("a");
        adminLink.href = "/admin/";
        adminLink.className = "w-full inline-flex items-center justify-center gap-2 bg-brand-600 text-white py-2.5 px-4 rounded-button hover:bg-brand-700 transition-colors text-sm font-semibold text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2";
        adminLink.textContent = "Panel Administrator";
        list.appendChild(adminLink);
      }

      const logoutLink = document.createElement("a");
      logoutLink.id = "logout-btn";
      logoutLink.href = "/auth/logout";
      logoutLink.className = "w-full inline-flex items-center justify-center gap-2 bg-white border border-red-200 text-red-600 py-2.5 px-4 rounded-button hover:bg-red-50 transition-colors text-sm font-medium text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2";
      logoutLink.textContent = "Keluar dari Akun";
      list.appendChild(logoutLink);

      box.appendChild(list);
      actionButtons.appendChild(box);

      logoutLink.addEventListener("click", (e) => {
        e.preventDefault();
        localStorage.removeItem("token");
        localStorage.removeItem("role");
        localStorage.removeItem("userName");
        localStorage.removeItem("userEmail");
        window.location.href = "/";
      });

      editBtn.addEventListener("click", openEditModal);
      document.querySelector("#edit-profile-inline")?.addEventListener("click", openEditModal);
    }

    let modalBound = false;
    function bindModalEvents() {
      if (modalBound) return;
      modalBound = true;
      document.querySelector("#edit-modal-backdrop")?.addEventListener("click", closeEditModal);
      document.querySelector("#cancel-edit")?.addEventListener("click", (e) => { e.preventDefault(); closeEditModal(); });
      document.querySelector("#edit-profile-form")?.addEventListener("submit", submitEditForm);
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          const modal = document.querySelector("#edit-modal");
          if (modal && !modal.classList.contains("hidden")) closeEditModal();
        }
      });
    }

    function openEditModal() {
      const modal = document.querySelector("#edit-modal");
      if (!modal) return;
      const inputNama = document.querySelector("#input-nama");
      const inputEmail = document.querySelector("#input-email");
      const inputPhone = document.querySelector("#input-phone");
      const inputAddress = document.querySelector("#input-address");
      const fullname = document.querySelector("#user-fullname")?.textContent || "";
      const email = document.querySelector("#user-email")?.textContent || "";
      const phone = document.querySelector("#user-phone")?.textContent || "";
      const address = document.querySelector("#user-address")?.textContent || "";
      if (inputNama) inputNama.value = fullname === "-" ? "" : fullname;
      if (inputEmail) inputEmail.value = email === "-" ? "" : email;
      if (inputPhone) inputPhone.value = phone === "-" ? "" : phone;
      if (inputAddress) inputAddress.value = address === "-" ? "" : address;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.style.overflow = "hidden";
      setTimeout(() => inputNama?.focus(), 50);
    }

    function closeEditModal() {
      const modal = document.querySelector("#edit-modal");
      if (!modal) return;
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.style.overflow = "";
    }

    async function submitEditForm(e) {
      e.preventDefault();
      const token = localStorage.getItem("token");
      if (!token) {
        if (window.showToast)
          window.showToast("Anda harus masuk untuk mengedit profil", "warning");
        return;
      }

      const nama = document.querySelector("#input-nama")?.value || "";
      const email = document.querySelector("#input-email")?.value || "";
      const nomorHp = document.querySelector("#input-phone")?.value || "";
      const alamat = document.querySelector("#input-address")?.value || "";

      try {
        const res = await fetch(`${API_URL}/auth/profile`, {
          method: "PUT",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify({ nama, email, nomorHp, alamat }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Gagal mengupdate profil");

        // Update DOM with new data
        document.querySelector("#user-name").textContent =
          data.user.nama || nama;
        document.querySelector("#user-fullname").textContent =
          data.user.nama || nama;
        document.querySelector("#user-email").textContent =
          data.user.email || email;
        document.querySelector("#user-phone").textContent =
          data.user.nomorHp || nomorHp;
        document.querySelector("#user-address").textContent =
          data.user.alamat || alamat;

        // Update localStorage
        if (data.user.nama) localStorage.setItem("userName", data.user.nama);
        if (data.user.email) localStorage.setItem("userEmail", data.user.email);

        closeEditModal();
        if (window.showToast)
          window.showToast("Profil berhasil diperbarui", "success");
      } catch (err) {
        console.error(err);
        const msg =
          err instanceof Error ? err.message : "Gagal mengupdate profil";
        if (window.showToast) window.showToast(msg, "error");
      }
    }

    // Ringkasan riwayat donasi: gunakan endpoint yang sama tapi tampilkan ringkasan + tombol ke subhalaman
    async function fetchDonationSummary(token) {
      const container = document.querySelector("#donation-summary-container");
      const textEl = document.querySelector("#donation-summary-text");
      if (!container || !textEl) return;

      try {
        textEl.textContent = "Memuat ringkasan riwayat donasi...";
        const res = await fetch(`${API_URL}/donations/my-donations?limit=50`, {
          headers: { Authorization: `Bearer ${token}` },
        });
        if (!res.ok) throw new Error("Gagal memuat riwayat donasi");
        const data = await res.json();
        const donations = data.donations || [];
        if (donations.length === 0) {
          textEl.innerHTML = `Belum ada riwayat donasi. <a href="/campaign" class="text-brand-600 hover:text-brand-700 font-medium underline underline-offset-4">Mulai Donasi</a>`;
        } else {
          const count = donations.length;
          const last = donations[0];
          const date = new Date(last.createdAt).toLocaleDateString("id-ID", {
            day: "numeric",
            month: "short",
            year: "numeric",
          });
          textEl.innerHTML = `Anda memiliki <strong class="font-semibold text-foreground">${count}</strong> donasi. Terakhir: <span class="font-medium text-foreground">${date}</span> · <a href="/profile/donations" class="text-brand-600 hover:text-brand-700 font-medium underline underline-offset-4">Lihat semua</a>`;
        }
      } catch (err) {
        console.error(err);
        if (window.showToast)
          window.showToast("Gagal memuat ringkasan riwayat donasi", "error");
        textEl.textContent = "Gagal memuat ringkasan riwayat donasi.";
      }
    }

    document.addEventListener("DOMContentLoaded", () => {
      bindModalEvents();
      checkAuthStatus();
    });
    window.addEventListener("storage", checkAuthStatus);
  </script>
</PrimaryLayout>
