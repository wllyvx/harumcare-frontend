<script>
  // Salin tautan — kecil, aman (textContent only, tanpa innerHTML).
  // Tahan klik ganda cepat + fallback textarea bila Clipboard API ditolak.
  function initCopyLink() {
    const btn = document.querySelector("[data-copy-link]");
    const feedback = document.querySelector("[data-copy-feedback]");
    const feedbackFail = document.querySelector("[data-copy-feedback-fail]");
    if (!(btn instanceof HTMLButtonElement)) return;
    let busy = false;
    let hideTimer = 0;
    const show = (el: Element | null) => {
      if (!(el instanceof HTMLElement)) return;
      el.classList.remove("hidden");
      window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(
        () => el.classList.add("hidden"),
        2000,
      );
    };
    const hide = (el: Element | null) => {
      if (el instanceof HTMLElement) el.classList.add("hidden");
    };
    btn.addEventListener("click", async () => {
      if (busy) return;
      busy = true;
      btn.setAttribute("aria-disabled", "true");
      (btn as HTMLButtonElement).disabled = true;
      const url = btn.getAttribute("data-copy-link") || window.location.href;
      let copied = false;
      try {
        await navigator.clipboard.writeText(url);
        copied = true;
      } catch {
        try {
          const ta = document.createElement("textarea");
          ta.value = url;
          ta.setAttribute("readonly", "");
          ta.style.position = "fixed";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          copied = document.execCommand("copy");
          ta.remove();
        } catch {
          copied = false;
        }
      } finally {
        busy = false;
        btn.removeAttribute("aria-disabled");
        (btn as HTMLButtonElement).disabled = false;
      }
      if (copied) {
        hide(feedbackFail);
        show(feedback);
      } else {
        hide(feedback);
        show(feedbackFail);
      }
    });
  }

  // Gambar rusak di mana pun (konten CMS, kampanye, baca-selanjutnya) → placeholder, sekali saja.
  function initImgFallback() {
    document.addEventListener(
      "error",
      (e) => {
        const t = e.target;
        if (!(t instanceof HTMLImageElement)) return;
        if (t.dataset.fbk === "1") return;
        t.dataset.fbk = "1";
        t.src = "/images/empty-image-placeholder.webp";
      },
      true,
    );
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      initCopyLink();
      initImgFallback();
    });
  } else {
    initCopyLink();
    initImgFallback();
  }
</script>
