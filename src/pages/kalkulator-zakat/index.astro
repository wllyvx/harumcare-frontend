---
import PrimaryLayout from "../../layouts/PrimaryLayout.astro";
---
<PrimaryLayout>
    <section class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-10">
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight mb-2 text-balance">Kalkulator & Pembayaran Zakat</h1>
        <p class="text-sm md:text-base text-gray-600 mb-4 max-w-2xl">Hitung kewajiban zakat Anda secara akurat dan lanjutkan ke formulir pembayaran.</p>
        <ul aria-label="Kepercayaan perhitungan zakat" class="mb-2 grid grid-cols-1 min-[480px]:grid-cols-3 gap-2 max-w-2xl">
            <li class="flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-xs text-gray-700">
                <svg class="w-4 h-4 shrink-0 text-blue-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
                <span>Nisab 85 gr emas / 595 gr perak</span>
            </li>
            <li class="flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-xs text-gray-700">
                <svg class="w-4 h-4 shrink-0 text-blue-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>
                <span>Bukti via email &amp; WhatsApp</span>
            </li>
            <li class="flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-xs text-gray-700">
                <svg class="w-4 h-4 shrink-0 text-blue-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                <span>Penyaluran via <a href="/campaign" class="underline underline-offset-2 font-medium text-blue-700 hover:text-blue-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-sm">campaign transparan</a></span>
            </li>
        </ul>
        <p class="text-xs text-gray-500 mb-8 max-w-2xl">Ragu soal haul atau nisab? <a href="/pojok-konsultasi" class="underline underline-offset-2 font-medium text-blue-700 hover:text-blue-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-sm">Tanya via Pojok Konsultasi</a>.</p>
        <noscript>
            <div class="mb-6 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900" role="alert">
                Kalkulator membutuhkan JavaScript untuk menghitung nisab. Aktifkan JavaScript, atau hubungi kami melalui halaman konsultasi untuk bantuan perhitungan manual.
            </div>
        </noscript>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 items-start">
            <!-- Left: Calculator (leads) -->
            <div class="lg:col-span-2 min-w-0 bg-white p-5 sm:p-7 rounded-xl shadow-md flex flex-col gap-6">
                <!-- Tabs -->
                <div>
                    <nav class="grid grid-cols-1 gap-1 p-1 bg-gray-100 rounded-xl min-[480px]:flex min-[480px]:overflow-x-auto" role="tablist" aria-label="Jenis Zakat">
                        <button role="tab" id="tab-penghasilan" aria-selected="true" aria-controls="form-penghasilan" tabindex="0" data-tab="penghasilan" class="tab-btn w-full min-[480px]:flex-1 min-[480px]:whitespace-nowrap px-3 py-2.5 min-h-[44px] inline-flex items-center justify-center rounded-lg bg-blue-50 text-blue-700 border border-blue-100 text-sm font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2">Zakat Penghasilan</button>
                        <button role="tab" id="tab-perdagangan" aria-selected="false" aria-controls="form-perdagangan" tabindex="-1" data-tab="perdagangan" class="tab-btn w-full min-[480px]:flex-1 min-[480px]:whitespace-nowrap px-3 py-2.5 min-h-[44px] inline-flex items-center justify-center rounded-lg bg-white text-gray-700 border border-gray-200 text-sm font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2">Zakat Perdagangan</button>
                        <button role="tab" id="tab-emasperak" aria-selected="false" aria-controls="form-emasperak" tabindex="-1" data-tab="emasperak" class="tab-btn w-full min-[480px]:flex-1 min-[480px]:whitespace-nowrap px-3 py-2.5 min-h-[44px] inline-flex items-center justify-center rounded-lg bg-white text-gray-700 border border-gray-200 text-sm font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2">Zakat Emas &amp; Perak</button>
                    </nav>
                </div>

                <!-- Price inputs used for nisab calculation -->
                <fieldset class="bg-gray-50 rounded-xl p-4 flex flex-col gap-1 min-w-0">
                    <legend class="sr-only">Harga acuan nisab</legend>
                    <p class="text-xs font-semibold uppercase tracking-wide text-gray-600" aria-hidden="true">Harga acuan nisab</p>
                    <p id="price-hint" class="text-xs text-gray-500">Acuan default dapat diubah mengikuti harga pasar hari ini. Semua nominal dalam Rupiah.</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-2">
                    <label class="flex flex-col gap-1.5 text-sm font-medium text-gray-700 min-w-0">
                        Harga Emas (per gr)
                        <input id="priceGold" type="text" inputmode="numeric" autocomplete="off" maxlength="19" placeholder="cth. 1.150.000" aria-describedby="price-hint priceGold-error" class="p-3 border rounded-md w-full shadow-sm border-gray-200 font-normal placeholder:text-gray-500 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/30" value="1150000" />
                        <span id="priceGold-error" class="hidden text-sm font-normal text-red-600" aria-live="polite"></span>
                    </label>
                    <label class="flex flex-col gap-1.5 text-sm font-medium text-gray-700 min-w-0">
                        Harga Perak (per gr)
                        <input id="priceSilver" type="text" inputmode="numeric" autocomplete="off" maxlength="19" placeholder="cth. 12.000" aria-describedby="price-hint priceSilver-error" class="p-3 border rounded-md w-full shadow-sm border-gray-200 font-normal placeholder:text-gray-500 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/30" value="12000" />
                        <span id="priceSilver-error" class="hidden text-sm font-normal text-red-600" aria-live="polite"></span>
                    </label>
                    </div>
                </fieldset>

                <!-- Forms -->
                <div class="min-w-0">
                    <!-- Penghasilan -->
                    <form id="form-penghasilan" role="tabpanel" aria-labelledby="tab-penghasilan" tabindex="0" class="zakat-form focus:outline-none">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <label class="flex flex-col gap-1.5 text-sm font-medium text-gray-700 min-w-0">
                                Jumlah penghasilan / gaji (1 tahun)
                                <input id="income_year" type="text" inputmode="numeric" autocomplete="off" maxlength="19" placeholder="cth. 96.000.000" aria-describedby="income_year-error" class="p-3 border rounded-md w-full shadow-sm border-gray-200 font-normal placeholder:text-gray-500 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/30" value="0" />
                                <span id="income_year-error" class="hidden text-sm font-normal text-red-600" aria-live="polite"></span>
                            </label>
                            <label class="flex flex-col gap-1.5 text-sm font-medium text-gray-700 min-w-0">
                                Pendapatan lain (bonus, THR) (1 tahun)
                                <input id="income_other" type="text" inputmode="numeric" autocomplete="off" maxlength="19" placeholder="cth. 6.000.000" aria-describedby="income_other-error" class="p-3 border rounded-md w-full shadow-sm border-gray-200 font-normal placeholder:text-gray-500 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/30" value="0" />
                                <span id="income_other-error" class="hidden text-sm font-normal text-red-600" aria-live="polite"></span>
                            </label>
                        </div>
                        <div class="mt-6 p-5 sm:p-6 bg-blue-50 border border-blue-100 rounded-xl flex flex-col gap-4 min-w-0">
                            <div class="flex flex-wrap items-center justify-between gap-2 pb-4 border-b border-blue-100 min-w-0">
                                <div class="flex items-center gap-2 text-sm font-medium text-blue-900 min-w-0">
                                    <!-- gold icon -->
                                    <svg class="w-4 h-4 shrink-0 text-yellow-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.5 5.5L20 9l-4 3 1 6-5-3-5 3 1-6-4-3 5.5-1.5L12 2z" /></svg>
                                    <span class="min-w-0 break-words">Nisab (85 gr emas): <span id="nisab_income_text" class="font-semibold tabular-nums" aria-live="polite" aria-atomic="true">-</span></span>
                                </div>
                                <span class="inline-flex shrink-0 items-center px-2.5 py-1 rounded-full bg-white border border-blue-200 text-blue-800 text-xs font-bold tracking-wide">Kadar 2,5%</span>
                            </div>

                            <div class="flex flex-col sm:flex-row sm:items-end gap-3 justify-between">
                                <div class="min-w-0">
                                    <div class="text-xs font-semibold uppercase tracking-wider text-blue-800">Zakat yang harus dibayar</div>
                                    <div class="mt-1.5 text-3xl md:text-4xl font-extrabold tracking-tight text-blue-900 tabular-nums break-words min-h-[2.75rem]" aria-live="polite" aria-atomic="true"><span id="result_income">Rp 0</span></div>
                                    <p class="mt-1.5 text-xs text-blue-800">Dihitung × 2,5% dari harta kena zakat • Nisab mengikuti harga acuan di atas.</p>
                                </div>
                                <div class="shrink-0 self-start sm:self-center">
                                    <div id="status_income" role="status" aria-live="polite" class="px-3 py-1.5 rounded-full bg-white border border-blue-200 text-blue-800 text-xs font-bold tracking-wide">BELUM WAJIB</div>
                                </div>
                            </div>

                            <div id="hint_income" role="status" class="hint-text mt-1 text-sm text-blue-800 hidden break-words"></div>
                        </div>
                    </form>

                    <!-- Perdagangan -->
                    <form id="form-perdagangan" role="tabpanel" aria-labelledby="tab-perdagangan" tabindex="0" class="zakat-form hidden focus:outline-none">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <label class="flex flex-col gap-1.5 text-sm font-medium text-gray-700 whitespace-normal min-w-0">
                                Modal
                                <input id="trade_modal" type="text" inputmode="numeric" autocomplete="off" maxlength="19" placeholder="cth. 50.000.000" aria-describedby="trade_modal-error" class="p-3 border border-gray-200 rounded-md w-full shadow-sm font-normal placeholder:text-gray-500 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/30" value="0" />
                                <span id="trade_modal-error" class="hidden text-sm font-normal text-red-600" aria-live="polite"></span>
                            </label>
                            <label class="flex flex-col gap-1.5 text-sm font-medium text-gray-700 whitespace-normal min-w-0">
                                Laba
                                <input id="trade_profit" type="text" inputmode="numeric" autocomplete="off" maxlength="19" placeholder="cth. 10.000.000" aria-describedby="trade_profit-error" class="p-3 border border-gray-200 rounded-md w-full shadow-sm font-normal placeholder:text-gray-500 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/30" value="0" />
                                <span id="trade_profit-error" class="hidden text-sm font-normal text-red-600" aria-live="polite"></span>
                            </label>
                            <label class="flex flex-col gap-1.5 text-sm font-medium text-gray-700 whitespace-normal min-w-0">
                                Piutang lancar
                                <input id="trade_receivables" type="text" inputmode="numeric" autocomplete="off" maxlength="19" placeholder="cth. 5.000.000" aria-describedby="trade_receivables-error" class="p-3 border border-gray-200 rounded-md w-full shadow-sm font-normal placeholder:text-gray-500 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/30" value="0" />
                                <span id="trade_receivables-error" class="hidden text-sm font-normal text-red-600" aria-live="polite"></span>
                            </label>
                            <label class="flex flex-col gap-1.5 text-sm font-medium text-gray-700 whitespace-normal min-w-0">
                                Hutang jatuh tempo
                                <input id="trade_debts" type="text" inputmode="numeric" autocomplete="off" maxlength="19" placeholder="cth. 2.000.000" aria-describedby="trade_debts-error" class="p-3 border border-gray-200 rounded-md w-full shadow-sm font-normal placeholder:text-gray-500 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/30" value="0" />
                                <span id="trade_debts-error" class="hidden text-sm font-normal text-red-600" aria-live="polite"></span>
                            </label>
                            <label class="flex flex-col gap-1.5 text-sm font-medium text-gray-700 sm:col-span-2 whitespace-normal min-w-0">
                                Kerugian
                                <input id="trade_losses" type="text" inputmode="numeric" autocomplete="off" maxlength="19" placeholder="cth. 0" aria-describedby="trade_losses-error" class="p-3 border border-gray-200 rounded-md w-full shadow-sm font-normal placeholder:text-gray-500 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/30" value="0" />
                                <span id="trade_losses-error" class="hidden text-sm font-normal text-red-600" aria-live="polite"></span>
                            </label>
                        </div>

                        <div class="mt-6 p-5 sm:p-6 bg-blue-50 border border-blue-100 rounded-xl flex flex-col gap-4 min-w-0">
                            <div class="flex flex-wrap items-center justify-between gap-2 pb-4 border-b border-blue-100 min-w-0">
                                <div class="flex items-center gap-2 text-sm font-medium text-blue-900 min-w-0">
                                <svg class="w-4 h-4 shrink-0 text-yellow-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.5 5.5L20 9l-4 3 1 6-5-3-5 3 1-6-4-3 5.5-1.5L12 2z" /></svg>
                                <span class="min-w-0 break-words">Nisab (85 gr emas): <span id="nisab_trade_text" class="font-semibold tabular-nums" aria-live="polite" aria-atomic="true">-</span></span>
                                </div>
                                <span class="inline-flex shrink-0 items-center px-2.5 py-1 rounded-full bg-white border border-blue-200 text-blue-800 text-xs font-bold tracking-wide">Kadar 2,5%</span>
                            </div>

                            <div class="flex flex-col sm:flex-row sm:items-end gap-3 justify-between">
                                <div class="min-w-0">
                                    <div class="text-xs font-semibold uppercase tracking-wider text-blue-800">Zakat yang harus dibayar</div>
                                    <div class="mt-1.5 text-3xl md:text-4xl font-extrabold tracking-tight text-blue-900 tabular-nums break-words min-h-[2.75rem]" aria-live="polite" aria-atomic="true"><span id="result_trade">Rp 0</span></div>
                                    <p class="mt-1.5 text-xs text-blue-800">Dihitung × 2,5% dari harta dagang bersih • Nisab mengikuti harga acuan di atas.</p>
                                </div>
                                <div class="shrink-0 self-start sm:self-center">
                                    <div id="status_trade" role="status" aria-live="polite" class="px-3 py-1.5 rounded-full bg-white border border-blue-200 text-blue-800 text-xs font-bold tracking-wide">BELUM WAJIB</div>
                                </div>
                            </div>

                            <div id="hint_trade" role="status" class="hint-text mt-1 text-sm text-blue-800 hidden break-words"></div>
                        </div>
                    </form>

                    <!-- Emas & Perak -->
                    <form id="form-emasperak" role="tabpanel" aria-labelledby="tab-emasperak" tabindex="0" class="zakat-form hidden focus:outline-none">
                        <fieldset class="min-w-0">
                            <legend class="sr-only">Jenis logam</legend>
                            <div class="flex flex-wrap items-center gap-2 mb-3" role="radiogroup" aria-label="Jenis logam">
                                <label class="inline-flex items-center gap-2 px-3 py-2 min-h-[44px] border border-gray-200 rounded-lg cursor-pointer text-sm font-medium text-gray-700 focus-within:ring-2 focus-within:ring-blue-600 focus-within:ring-offset-1"><input type="radio" name="metal" value="gold" checked class="w-4 h-4 accent-blue-700" /> Emas</label>
                                <label class="inline-flex items-center gap-2 px-3 py-2 min-h-[44px] border border-gray-200 rounded-lg cursor-pointer text-sm font-medium text-gray-700 focus-within:ring-2 focus-within:ring-blue-600 focus-within:ring-offset-1"><input type="radio" name="metal" value="silver" class="w-4 h-4 accent-blue-700" /> Perak</label>
                            </div>
                        </fieldset>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <label class="flex flex-col gap-1.5 text-sm font-medium text-gray-700 min-w-0">
                                Jumlah dimiliki (gram)
                                <input id="metal_owned" type="text" inputmode="decimal" autocomplete="off" maxlength="12" placeholder="cth. 100" aria-describedby="metal_owned-error" class="p-3 border rounded-md w-full shadow-sm border-gray-200 font-normal placeholder:text-gray-500 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/30" value="0" />
                                <span id="metal_owned-error" class="hidden text-sm font-normal text-red-600" aria-live="polite"></span>
                            </label>
                            <label class="flex flex-col gap-1.5 text-sm font-medium text-gray-700 min-w-0">
                                Jumlah dipakai (gram)
                                <input id="metal_worn" type="text" inputmode="decimal" autocomplete="off" maxlength="12" placeholder="cth. 10" aria-describedby="metal_worn-error" class="p-3 border rounded-md w-full shadow-sm border-gray-200 font-normal placeholder:text-gray-500 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/30" value="0" />
                                <span id="metal_worn-error" class="hidden text-sm font-normal text-red-600" aria-live="polite"></span>
                            </label>
                        </div>
                        <div class="mt-6 p-5 sm:p-6 bg-blue-50 border border-blue-100 rounded-xl flex flex-col gap-4 min-w-0">
                            <div class="flex flex-wrap items-center justify-between gap-2 pb-4 border-b border-blue-100 min-w-0">
                                <div class="flex items-center gap-2 text-sm font-medium text-blue-900 min-w-0">
                                <svg class="w-4 h-4 shrink-0 text-yellow-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.5 5.5L20 9l-4 3 1 6-5-3-5 3 1-6-4-3 5.5-1.5L12 2z" /></svg>
                                <span class="min-w-0 break-words">Nisab: <span id="nisab_metal_text" class="font-semibold tabular-nums" aria-live="polite" aria-atomic="true">85 gr emas / 595 gr perak</span></span>
                                </div>
                                <span class="inline-flex shrink-0 items-center px-2.5 py-1 rounded-full bg-white border border-blue-200 text-blue-800 text-xs font-bold tracking-wide">Kadar 2,5%</span>
                            </div>

                            <div class="flex flex-col sm:flex-row sm:items-end gap-3 justify-between">
                                <div class="min-w-0">
                                    <div class="text-xs font-semibold uppercase tracking-wider text-blue-800">Zakat yang harus dibayar</div>
                                    <div class="mt-1.5 text-3xl md:text-4xl font-extrabold tracking-tight text-blue-900 tabular-nums break-words min-h-[2.75rem]" aria-live="polite" aria-atomic="true"><span id="result_metal">Rp 0</span></div>
                                    <p class="mt-1.5 text-xs text-blue-800">Dihitung × 2,5% dari berat bersih • Nisab 85 gr emas / 595 gr perak.</p>
                                </div>
                                <div class="shrink-0 self-start sm:self-center">
                                    <div id="status_metal" role="status" aria-live="polite" class="px-3 py-1.5 rounded-full bg-white border border-blue-200 text-blue-800 text-xs font-bold tracking-wide">BELUM WAJIB</div>
                                </div>
                            </div>

                            <div id="hint_metal" role="status" class="hint-text mt-1 text-sm text-blue-800 hidden break-words"></div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Right: Payment form (supports) -->
        <aside class="min-w-0 bg-white p-5 sm:p-6 rounded-xl shadow-md border border-blue-50 flex flex-col gap-5 lg:sticky lg:top-24 lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto scroll-mt-24" aria-labelledby="payment-heading">
                <h3 id="payment-heading" class="font-semibold text-base flex items-center gap-2 scroll-mt-24"><svg class="w-5 h-5 shrink-0 text-blue-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1c-5.523 0-10 4.477-10 10s4.477 10 10 10 10-4.477 10-10S17.523 1 12 1zm1 14h-2v-2h2v2zm0-4h-2V6h2v5z"/></svg>Detail Pembayaran</h3>
                <div>
                    <div class="text-sm text-gray-600">Nominal Zakat</div>
            <div id="paymentAmount" role="status" aria-live="polite" aria-atomic="true" aria-label="Nominal zakat terhitung" class="mt-2 p-4 border rounded-lg text-xl md:text-2xl font-bold tracking-tight bg-white text-blue-700 border-blue-200 tabular-nums break-words min-h-[4rem] flex items-center">Rp 0</div>
                    <p id="payment-source" class="mt-1.5 text-xs text-gray-500">Nominal mengikuti tab kalkulator yang aktif.</p>
                    <div id="sedekah-offramp" class="mt-3 rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">
                        <p class="font-semibold text-[13px]">Belum wajib zakat? Alhamdulillah.</p>
                        <p class="mt-0.5 text-[13px] leading-relaxed">Harta Anda di bawah nisab. Sedekah tetap dianjurkan dan bisa disalurkan sekarang.</p>
                        <div class="mt-2.5 flex flex-col min-[420px]:flex-row gap-2">
                            <a href="/campaign" class="inline-flex items-center justify-center min-h-[44px] px-3 py-2 rounded-lg bg-white border border-amber-300 text-amber-900 text-[13px] font-semibold hover:bg-amber-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-600 focus-visible:ring-offset-2 transition-colors">Lihat program sedekah</a>
                            <a href="/pojok-konsultasi" class="inline-flex items-center justify-center min-h-[44px] px-3 py-2 rounded-lg text-[13px] font-medium underline underline-offset-2 hover:text-amber-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-600 rounded-sm">Tanya konsultasi</a>
                        </div>
                    </div>
                </div>

                <form id="payment-form" novalidate class="flex flex-col gap-5 min-w-0">
                <div class="flex flex-col gap-4">
                <label class="flex flex-col gap-1.5 text-sm font-medium text-gray-700 min-w-0">Nama Lengkap
                    <input id="pay_name" type="text" autocomplete="name" enterkeyhint="next" maxlength="100" minlength="2" required placeholder="Masukkan nama Anda" aria-describedby="pay_name-error" class="p-3 border rounded-md w-full shadow-sm border-gray-200 font-normal placeholder:text-gray-500 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/30" />
                    <span id="pay_name-error" class="hidden text-sm font-normal text-red-600" aria-live="polite"></span>
                </label>
                <label class="flex flex-col gap-1.5 text-sm font-medium text-gray-700 min-w-0">Email
                    <input id="pay_email" type="email" autocomplete="email" enterkeyhint="next" maxlength="254" required placeholder="alamat@email.com" aria-describedby="pay_email-error" class="p-3 border rounded-md w-full shadow-sm border-gray-200 font-normal placeholder:text-gray-500 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/30" />
                    <span id="pay_email-error" class="hidden text-sm font-normal text-red-600" aria-live="polite"></span>
                </label>
                <label class="flex flex-col gap-1.5 text-sm font-medium text-gray-700 min-w-0">WhatsApp
                    <input id="pay_whatsapp" type="tel" inputmode="tel" autocomplete="tel" enterkeyhint="next" maxlength="16" placeholder="08xx..." aria-describedby="pay_whatsapp-error pay_whatsapp-hint" class="p-3 border rounded-md w-full shadow-sm border-gray-200 font-normal placeholder:text-gray-500 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/30" />
                    <span id="pay_whatsapp-hint" class="text-xs font-normal text-gray-500">Opsional. Format Indonesia, cth. 081234567890.</span>
                    <span id="pay_whatsapp-error" class="hidden text-sm font-normal text-red-600" aria-live="polite"></span>
                </label>
                </div>

                <fieldset class="min-w-0">
                    <legend class="text-sm font-medium text-gray-700 mb-2">Pilih Metode Pembayaran</legend>
                    <div class="grid grid-cols-1 min-[420px]:grid-cols-2 gap-2">
                        <label class="flex items-center gap-3 p-3 min-h-[44px] border border-gray-200 rounded-lg cursor-pointer focus-within:ring-2 focus-within:ring-blue-600 focus-within:ring-offset-1">
                            <input type="radio" name="method" value="va" checked class="w-4 h-4 shrink-0 accent-blue-700" />
                            <svg class="w-5 h-5 shrink-0 text-blue-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2 7v10a2 2 0 0 0 2 2h16V5H4a2 2 0 0 0-2 2zM7 12h10v2H7v-2z"/></svg>
                            <span class="text-sm">Virtual Account</span>
                        </label>
                        <label class="flex items-center gap-3 p-3 min-h-[44px] border border-gray-200 rounded-lg cursor-pointer focus-within:ring-2 focus-within:ring-blue-600 focus-within:ring-offset-1">
                            <input type="radio" name="method" value="ewallet" class="w-4 h-4 shrink-0 accent-blue-700" />
                            <svg class="w-5 h-5 shrink-0 text-blue-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2 7v10a2 2 0 0 0 2 2h16V5H4a2 2 0 0 0-2 2zm4 2h10v2H6V9z"/></svg>
                            <span class="text-sm">E-Wallet</span>
                        </label>
                    </div>
                </fieldset>

                <div id="payment-feedback" role="alert" aria-live="assertive" tabindex="-1" class="hidden rounded-lg border p-3 text-sm break-words focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2"></div>

                <div>
                    <button id="payBtn" type="submit" aria-describedby="payment-feedback payment-source" class="px-4 py-3.5 min-h-[48px] bg-blue-600 text-white font-semibold rounded-lg shadow-md w-full inline-flex items-center justify-center gap-2 transition-colors hover:bg-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 disabled:opacity-60 disabled:cursor-not-allowed">
                        <svg id="paySpinner" class="hidden w-5 h-5 animate-spin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" class="opacity-25"/><path d="M22 12a10 10 0 0 0-10-10" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg>
                        <span id="payBtnLabel">Tunaikan Zakat Sekarang</span>
                    </button>
                    <p class="mt-2 text-xs text-gray-500">Data hanya digunakan untuk bukti pembayaran zakat.</p>
                </div>

                <!-- hidden field to capture numeric amount for submission or later use -->
                <input type="hidden" id="paymentAmountValue" value="0" />
                </form>
            </aside>
        </div>

        <!-- Mobile sticky ringkasan: ringkas nominal + status, sembunyi saat form pembayaran terlihat -->
        <div id="mobile-summary" class="md:hidden fixed inset-x-3 z-40 rounded-xl border border-blue-100 bg-white/95 backdrop-blur px-4 py-3 shadow-lg transition-transform transition-opacity duration-200" style="bottom: calc(88px + env(safe-area-inset-bottom));" role="status" aria-live="polite" aria-atomic="true">
            <div class="flex items-center justify-between gap-3 min-w-0">
                <div class="min-w-0">
                    <div id="mobile-status" class="inline-flex items-center px-2 py-0.5 rounded-full bg-white border border-blue-200 text-blue-800 text-[11px] font-bold tracking-wide">BELUM WAJIB</div>
                    <div id="mobile-amount" class="mt-1 text-lg font-extrabold tracking-tight text-blue-900 tabular-nums truncate">Rp 0</div>
                </div>
                <a id="mobile-cta" href="/campaign" class="shrink-0 inline-flex items-center justify-center min-h-[44px] px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 transition-colors">Lihat sedekah</a>
            </div>
        </div>

    <style>
        html { scroll-behavior: smooth; }
        @media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            .tab-btn, #payBtn, #mobile-summary, #mobile-cta { transition: none !important; }
            #paySpinner { animation: none !important; }
        }
        input[aria-invalid="true"] { border-color: #dc2626; }
        ::selection { background: #dbeafe; color: #1e3a8a; }
        #mobile-summary[hidden] { display: none; }
        #mobile-summary.is-hidden { opacity: 0; transform: translateY(12px); pointer-events: none; }
    </style>

    <script type="module">
            import { calcIncomeZakat, calcTradeZakat, calcMetalZakat, nisabValueForGold } from '/js/zakat.js';

            const DEFAULT_GOLD = 1150000;
            const DEFAULT_SILVER = 12000;
            const MAX_RUPIAH = 999999999999999; // 999 triliun — batas format aman
            const MAX_GRAM = 100000;

            const currencyFormatter = new Intl.NumberFormat('id-ID');
            const toRupiah = (value) => {
                const v = Number(value) || 0;
                return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(Math.round(v));
            };

            const q = (s) => document.querySelector(s);
            const qa = (s) => Array.from(document.querySelectorAll(s));

            const debounce = (fn, wait = 150) => {
                let t;
                return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), wait); };
            };

            const notify = (msg, type = 'default') => {
                try { if (typeof window.showToast === 'function') window.showToast(msg, type); } catch (e) {}
            };

            // Currency helpers — pertahankan tanda negatif agar bisa divalidasi, bukan disembunyikan
            function parseNumberFromString(s){
                if(typeof s === 'number') return s;
                const str = String(s ?? '').trim();
                if(!str) return 0;
                const isNeg = /^-/.test(str);
                const digits = str.replace(/[^0-9]/g,'');
                if(!digits) return 0;
                const n = Number(digits);
                return isNeg ? -n : n;
            }

            function parseGrams(s){
                if(typeof s === 'number') return s;
                const str = String(s ?? '').trim();
                if(!str) return 0;
                const isNeg = /^-/.test(str);
                // id-ID: titik = ribuan, koma = desimal
                const normalized = str.replace(/\./g, '').replace(/,/g, '.').replace(/[^0-9.]/g, '');
                const n = Number(normalized);
                if(!Number.isFinite(n)) return 0;
                return isNeg ? -Math.abs(n) : n;
            }

            function formatNumberToText(n){
                return currencyFormatter.format(Math.round(Number(n) || 0));
            }

            function setError(el, msg){
                if(!el) return;
                el.setAttribute('aria-invalid', 'true');
                el.classList.add('border-red-500');
                el.classList.remove('border-gray-200');
                let node = document.getElementById(el.id + '-error');
                if(!node){
                    node = document.createElement('p');
                    node.id = el.id + '-error';
                    node.className = 'text-sm font-normal text-red-600';
                    node.setAttribute('aria-live', 'polite');
                    el.parentNode.appendChild(node);
                }
                node.textContent = msg;
                node.classList.remove('hidden');
            }

            function clearError(el){
                if(!el) return;
                el.removeAttribute('aria-invalid');
                el.classList.remove('border-red-500');
                if(!el.classList.contains('border-gray-200')) el.classList.add('border-gray-200');
                const node = document.getElementById(el.id + '-error');
                if(node){ node.textContent = ''; node.classList.add('hidden'); }
            }

            // Kompatibilitas dengan pemanggil lama
            function showValidation(el, msg){ setError(el, msg); }
            function clearValidation(el){ clearError(el); }

            function setFeedback(type, msg){
                const box = q('#payment-feedback');
                if(!box) return;
                box.classList.remove('hidden', 'border-red-200', 'bg-red-50', 'text-red-700', 'border-green-200', 'bg-green-50', 'text-green-800');
                if(type === 'error'){
                    box.classList.add('border-red-200', 'bg-red-50', 'text-red-700');
                } else {
                    box.classList.add('border-green-200', 'bg-green-50', 'text-green-800');
                }
                box.textContent = msg;
            }

            function clearFeedback(){
                const box = q('#payment-feedback');
                if(!box) return;
                box.textContent = '';
                box.classList.add('hidden');
            }

            function setHintWithSedekah(el, prefix, shortText){
                if(!el) return;
                el.innerHTML = '';
                el.className = 'hint-text mt-3 rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900 break-words';
                const title = document.createElement('p');
                title.className = 'font-semibold text-[13px]';
                title.textContent = 'Belum wajib zakat? Alhamdulillah.';
                const desc = document.createElement('p');
                desc.className = 'mt-0.5 text-[13px] leading-relaxed';
                desc.textContent = prefix + ' ' + shortText;
                const actions = document.createElement('div');
                actions.className = 'mt-2.5 flex flex-col min-[420px]:flex-row gap-2';
                const primary = document.createElement('a');
                primary.href = '/campaign';
                primary.className = 'inline-flex items-center justify-center min-h-[44px] px-3 py-2 rounded-lg bg-white border border-amber-300 text-amber-900 text-[13px] font-semibold hover:bg-amber-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-600 focus-visible:ring-offset-2 transition-colors';
                primary.textContent = 'Lihat program sedekah';
                const secondary = document.createElement('a');
                secondary.href = '/pojok-konsultasi';
                secondary.className = 'inline-flex items-center justify-center min-h-[44px] px-3 py-2 rounded-lg text-[13px] font-medium underline underline-offset-2 hover:text-amber-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-600 rounded-sm';
                secondary.textContent = 'Tanya konsultasi';
                actions.append(primary, secondary);
                el.append(title, desc, actions);
                el.classList.remove('hidden');
            }

            function getVal(selector){
                const el = q(selector);
                if(!el) return 0;
                if(el.dataset && el.dataset.value !== undefined && el.dataset.value !== '') return Number(el.dataset.value) || 0;
                return parseNumberFromString(el.value || '');
            }

            function getValidPrice(selector, fallback, label){
                const el = q(selector);
                const raw = parseNumberFromString(el ? el.value : '');
                if(!Number.isFinite(raw) || raw <= 0){
                    if(el) setError(el, label + ' harus lebih dari 0. Menggunakan acuan default ' + formatNumberToText(fallback) + '.');
                    return fallback;
                }
                if(raw > MAX_RUPIAH){
                    if(el) setError(el, label + ' terlalu besar. Dibatasi ' + formatNumberToText(MAX_RUPIAH) + '.');
                    return MAX_RUPIAH;
                }
                if(el) clearError(el);
                return raw;
            }

            function bindCurrencyInput(selector){
                qa(selector).forEach(el => {
                    try{ el.type = 'text'; } catch(e){}
                    const initial = parseNumberFromString(el.value || el.getAttribute('value') || '0');
                    const clamped = initial < 0 ? 0 : Math.min(initial, MAX_RUPIAH);
                    el.dataset.value = String(clamped);
                    el.value = clamped ? formatNumberToText(clamped) : '';
                    if(initial < 0) setError(el, 'Nilai tidak boleh negatif. Dihitung sebagai 0.');
                    const apply = () => {
                        const raw = parseNumberFromString(el.value);
                        if(raw < 0){
                            setError(el, 'Nilai tidak boleh negatif. Dihitung sebagai 0.');
                            el.dataset.value = '0';
                            el.value = '';
                        } else if(raw > MAX_RUPIAH){
                            setError(el, 'Nilai terlalu besar. Dibatasi ' + formatNumberToText(MAX_RUPIAH) + '.');
                            el.dataset.value = String(MAX_RUPIAH);
                            el.value = formatNumberToText(MAX_RUPIAH);
                        } else {
                            clearError(el);
                            el.dataset.value = String(raw);
                            el.value = raw ? formatNumberToText(raw) : '';
                        }
                        clearFeedback();
                        recalcAll();
                    };
                    const debounced = debounce(apply, 150);
                    el.addEventListener('input', debounced);
                    el.addEventListener('blur', () => {
                        // Pastikan harga acuan ikut tervalidasi saat selesai mengetik
                        if(el.id === 'priceGold' || el.id === 'priceSilver') validatePrices(false);
                        else apply();
                    });
                    el.addEventListener('change', () => {
                        if(el.id === 'priceGold' || el.id === 'priceSilver'){
                            validatePrices(true);
                            recalcAll();
                        }
                    });
                });
            }

            function bindGramInput(selector){
                qa(selector).forEach(el => {
                    const apply = () => {
                        const raw = parseGrams(el.value);
                        if(raw < 0){
                            setError(el, 'Nilai tidak boleh negatif. Dihitung sebagai 0.');
                        } else if(raw > MAX_GRAM){
                            setError(el, 'Nilai terlalu besar. Maksimal ' + formatNumberToText(MAX_GRAM) + ' gram.');
                            el.value = formatNumberToText(MAX_GRAM);
                        } else {
                            clearError(el);
                        }
                        clearFeedback();
                        recalcAll();
                    };
                    el.addEventListener('input', debounce(apply, 150));
                    el.addEventListener('blur', apply);
                });
            }

            function validatePrices(announce){
                const gold = getValidPrice('#priceGold', DEFAULT_GOLD, 'Harga emas');
                const silver = getValidPrice('#priceSilver', DEFAULT_SILVER, 'Harga perak');
                if(announce){
                    const goldEl = q('#priceGold');
                    const silverEl = q('#priceSilver');
                    const hasError = (goldEl && goldEl.hasAttribute('aria-invalid')) || (silverEl && silverEl.hasAttribute('aria-invalid'));
                    if(!hasError) notify('Nisab diperbarui mengikuti harga acuan.', 'default');
                }
                return { gold, silver };
            }

            // Tabs — pola tab asli dengan roving tabindex + navigasi panah
            const tabs = qa('.tab-btn');
            function selectTab(tab, focus = false){
                const name = tab.getAttribute('data-tab');
                tabs.forEach(b => {
                    const active = b === tab;
                    b.classList.toggle('bg-blue-50', active);
                    b.classList.toggle('text-blue-700', active);
                    b.classList.toggle('border-blue-100', active);
                    b.classList.toggle('bg-white', !active);
                    b.classList.toggle('text-gray-700', !active);
                    b.setAttribute('aria-selected', active ? 'true' : 'false');
                    b.tabIndex = active ? 0 : -1;
                });
                qa('.zakat-form').forEach(f => f.classList.add('hidden'));
                const panel = q('#form-' + name);
                if(panel) panel.classList.remove('hidden');
                if(focus) tab.focus();
                clearFeedback();
                recalcAll();
            }

            tabs.forEach((btn, i) => {
                btn.addEventListener('click', () => selectTab(btn, false));
                btn.addEventListener('keydown', (e) => {
                    let next = null;
                    if(e.key === 'ArrowRight' || e.key === 'ArrowDown') next = tabs[(i + 1) % tabs.length];
                    if(e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = tabs[(i - 1 + tabs.length) % tabs.length];
                    if(e.key === 'Home') next = tabs[0];
                    if(e.key === 'End') next = tabs[tabs.length - 1];
                    if(next){ e.preventDefault(); selectTab(next, true); }
                });
            });

            function setStatus(el, wajib){
                if(!el) return;
                el.textContent = wajib ? 'WAJIB ZAKAT' : 'BELUM WAJIB';
                el.classList.toggle('bg-blue-700', wajib);
                el.classList.toggle('text-white', wajib);
                el.classList.toggle('border-blue-700', wajib);
                el.classList.toggle('bg-white', !wajib);
                el.classList.toggle('border-blue-200', !wajib);
                el.classList.toggle('text-blue-800', !wajib);
            }

            // Calculate functions using utils
            function recalcIncome(){
                const income = getVal('#income_year');
                const other = getVal('#income_other');
                const { gold } = validatePrices(false);
                const nisab = nisabValueForGold(gold);
                const taxable = income + other;
                let zakat = 0;
                try { zakat = calcIncomeZakat(income, other); } catch (e) { zakat = taxable * 0.025; }
                q('#nisab_income_text').textContent = toRupiah(nisab);
                q('#result_income').textContent = toRupiah(zakat);
                const hintIncome = q('#hint_income');
                if(taxable >= nisab && nisab > 0){
                    setStatus(q('#status_income'), true);
                    hintIncome.classList.add('hidden');
                    hintIncome.innerHTML = '';
                } else {
                    setStatus(q('#status_income'), false);
                    const short = Math.max(0, nisab - taxable);
                    setHintWithSedekah(hintIncome, 'Belum wajib zakat. Nisab ' + toRupiah(nisab) + '. Jarak ke nisab ' + toRupiah(short) + '.', 'Sedekah tetap dianjurkan.');
                }
                updatePayment(zakat);
            }

            function recalcTrade(){
                const modal = getVal('#trade_modal');
                const profit = getVal('#trade_profit');
                const receivables = getVal('#trade_receivables');
                const debts = getVal('#trade_debts');
                const losses = getVal('#trade_losses');
                const { gold } = validatePrices(false);
                const nisab = nisabValueForGold(gold);
                const net = (modal + profit + receivables) - (debts + losses);
                let zakat = 0;
                try { zakat = calcTradeZakat(modal, profit, receivables, debts, losses); } catch (e) { zakat = Math.max(0, net) * 0.025; }
                q('#nisab_trade_text').textContent = toRupiah(nisab);
                q('#result_trade').textContent = toRupiah(zakat);
                const hintTrade = q('#hint_trade');
                if(net >= nisab && nisab > 0){
                    setStatus(q('#status_trade'), true);
                    hintTrade.classList.add('hidden');
                    hintTrade.innerHTML = '';
                } else {
                    setStatus(q('#status_trade'), false);
                    const short = Math.max(0, nisab - net);
                    setHintWithSedekah(hintTrade, 'Belum wajib zakat. Nisab ' + toRupiah(nisab) + '. Jarak ke nisab ' + toRupiah(short) + '.', 'Sedekah tetap dianjurkan.');
                }
                updatePayment(zakat);
            }

            function recalcMetal(){
                const metalEl = document.querySelector('input[name="metal"]:checked');
                const metal = metalEl ? metalEl.value : 'gold';
                const ownedEl = q('#metal_owned');
                const wornEl = q('#metal_worn');
                const owned = parseGrams(ownedEl ? ownedEl.value : '0') || 0;
                const worn = parseGrams(wornEl ? wornEl.value : '0') || 0;
                const { gold, silver } = validatePrices(false);
                const price = metal === 'gold' ? gold : silver;
                const nisabGr = metal === 'gold' ? 85 : 595;
                const nisabIdr = nisabGr * price;
                const netGr = Math.max(0, owned - worn);
                let zakatIdr = 0;
                try { zakatIdr = calcMetalZakat(netGr, price); } catch (e) { zakatIdr = netGr * 0.025 * price; }
                q('#nisab_metal_text').textContent = nisabGr + ' gr (' + toRupiah(nisabIdr) + ')';
                q('#result_metal').textContent = toRupiah(zakatIdr);
                const hintMetal = q('#hint_metal');
                if(worn > owned){
                    if(wornEl) setError(wornEl, 'Jumlah dipakai melebihi dimiliki. Kelebihan diabaikan, dihitung ' + netGr + ' gr.');
                } else if(wornEl && !wornEl.hasAttribute('aria-invalid')){
                    // biarkan error negatif/terlalu besar dari bindGramInput jika ada
                }
                if(netGr >= nisabGr){
                    setStatus(q('#status_metal'), true);
                    if(worn <= owned){ hintMetal.classList.add('hidden'); hintMetal.innerHTML = ''; }
                    else {
                        hintMetal.classList.remove('hidden');
                        const warn = hintMetal.querySelector('[data-worn-warn]');
                        if(!warn){
                            const p = document.createElement('p');
                            p.setAttribute('data-worn-warn', 'true');
                            p.textContent = 'Catatan: jumlah dipakai melebihi dimiliki, dihitung ' + netGr + ' gr.';
                            hintMetal.append(p);
                        }
                    }
                } else {
                    setStatus(q('#status_metal'), false);
                    const shortGr = Math.max(0, nisabGr - netGr);
                    hintMetal.innerHTML = '';
                    hintMetal.className = 'hint-text mt-3 rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900 break-words';
                    const title = document.createElement('p');
                    title.className = 'font-semibold text-[13px]';
                    title.textContent = 'Belum wajib zakat? Alhamdulillah.';
                    hintMetal.append(title);
                    const base = document.createElement('p');
                    base.className = 'mt-0.5 text-[13px] leading-relaxed';
                    base.textContent = 'Belum wajib zakat. Nisab ' + nisabGr + ' gr. Jarak ke nisab ' + shortGr + ' gr. Sedekah tetap dianjurkan.';
                    hintMetal.append(base);
                    const actions = document.createElement('div');
                    actions.className = 'mt-2.5 flex flex-col min-[420px]:flex-row gap-2';
                    const link = document.createElement('a');
                    link.href = '/campaign';
                    link.className = 'inline-flex items-center justify-center min-h-[44px] px-3 py-2 rounded-lg bg-white border border-amber-300 text-amber-900 text-[13px] font-semibold hover:bg-amber-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-600 focus-visible:ring-offset-2 transition-colors';
                    link.textContent = 'Lihat program sedekah';
                    actions.append(link);
                    const consult = document.createElement('a');
                    consult.href = '/pojok-konsultasi';
                    consult.className = 'inline-flex items-center justify-center min-h-[44px] px-3 py-2 rounded-lg text-[13px] font-medium underline underline-offset-2 hover:text-amber-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-600 rounded-sm';
                    consult.textContent = 'Tanya konsultasi';
                    actions.append(consult);
                    hintMetal.append(actions);
                    if(worn > owned){
                        const p = document.createElement('p');
                        p.className = 'mt-2 text-[13px]';
                        p.textContent = 'Catatan: jumlah dipakai melebihi dimiliki, dihitung ' + netGr + ' gr.';
                        hintMetal.append(p);
                    }
                    hintMetal.classList.remove('hidden');
                }
                updatePayment(zakatIdr);
            }

            function recalcAll(){
                const visible = document.querySelector('.zakat-form:not(.hidden)');
                if(!visible) return;
                try {
                    if(visible.id === 'form-penghasilan') recalcIncome();
                    if(visible.id === 'form-perdagangan') recalcTrade();
                    if(visible.id === 'form-emasperak') recalcMetal();
                } catch (err) {
                    setFeedback('error', 'Perhitungan gagal. Periksa kembali angka yang dimasukkan, lalu coba lagi.');
                }
            }

            // update payment display and hidden value + sticky ringkasan + sedekah off-ramp
            function updatePayment(amount){
                const v = Number(amount) || 0;
                q('#paymentAmount').textContent = toRupiah(v);
                q('#paymentAmountValue').value = String(Math.round(v));
                const offramp = q('#sedekah-offramp');
                if(offramp) offramp.classList.toggle('hidden', v > 0);
                const mAmount = q('#mobile-amount');
                if(mAmount) mAmount.textContent = toRupiah(v);
                setStatus(q('#mobile-status'), v > 0);
                const mCta = q('#mobile-cta');
                if(mCta){
                    if(v > 0){
                        mCta.href = '#payment-heading';
                        mCta.textContent = 'Lanjut bayar';
                    } else {
                        mCta.href = '/campaign';
                        mCta.textContent = 'Lihat sedekah';
                    }
                }
            }

            // Sembunyikan bar mobile saat form pembayaran terlihat (hindari menutup tombol bayar / bottom nav)
            function initMobileSummary(){
                const bar = q('#mobile-summary');
                const target = q('#payment-form');
                if(!bar || !target) return;
                if(!('IntersectionObserver' in window)){
                    return;
                }
                const io = new IntersectionObserver((entries) => {
                    entries.forEach((entry) => {
                        bar.classList.toggle('is-hidden', entry.isIntersecting);
                    });
                }, { rootMargin: '-80px 0px 0px 0px', threshold: 0.15 });
                io.observe(target);
            }
            initMobileSummary();

            // Bind currency formatting to monetary inputs
            bindCurrencyInput('#priceGold, #priceSilver, #income_year, #income_other, #trade_modal, #trade_profit, #trade_receivables, #trade_debts, #trade_losses');

            // Gram inputs mengizinkan desimal (koma/titik)
            bindGramInput('#metal_owned, #metal_worn');
            qa('input[name="metal"]').forEach(el => el.addEventListener('change', recalcAll));

            // Validasi gagal impor util — degradasi yang jelas, bukan diam
            if(typeof calcIncomeZakat !== 'function' || typeof calcTradeZakat !== 'function' || typeof calcMetalZakat !== 'function'){
                setFeedback('error', 'Modul perhitungan tidak dapat dimuat. Muat ulang halaman. Jika berlanjut, gunakan browser terbaru.');
            }

            // Initial calculation
            recalcAll();

            // Payment — validasi inline + cegah double-submit, tanpa alert()
            let isSubmitting = false;
            const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
            const paymentForm = q('#payment-form');

            function validatePayment(){
                const amount = Number(q('#paymentAmountValue').value) || 0;
                const nameEl = q('#pay_name');
                const emailEl = q('#pay_email');
                const waEl = q('#pay_whatsapp');
                const firstInvalid = [];

                if(amount <= 0){
                    setFeedback('error', 'Nominal zakat masih Rp 0. Isi form kalkulator hingga muncul nominal, lalu coba lagi.');
                    const visible = document.querySelector('.zakat-form:not(.hidden) input');
                    if(visible) firstInvalid.push(visible);
                }

                const name = (nameEl.value || '').trim();
                if(!name){
                    setError(nameEl, 'Nama harus diisi.');
                    firstInvalid.push(nameEl);
                } else if(name.length < 2){
                    setError(nameEl, 'Nama minimal 2 karakter.');
                    firstInvalid.push(nameEl);
                } else if(name.length > 100){
                    setError(nameEl, 'Nama maksimal 100 karakter.');
                    firstInvalid.push(nameEl);
                } else {
                    clearError(nameEl);
                }

                const email = (emailEl.value || '').trim();
                if(!email){
                    setError(emailEl, 'Email harus diisi untuk bukti pembayaran.');
                    firstInvalid.push(emailEl);
                } else if(email.length > 254 || !emailRe.test(email)){
                    setError(emailEl, 'Masukkan email yang valid, cth. nama@email.com.');
                    firstInvalid.push(emailEl);
                } else {
                    clearError(emailEl);
                }

                const waRaw = (waEl.value || '').trim().replace(/[\s\-.]/g, '');
                if(waRaw){
                    if(!/^08[0-9]{7,13}$/.test(waRaw)){
                        setError(waEl, 'Nomor WhatsApp tidak valid. Gunakan format 08xx, 10–15 digit.');
                        firstInvalid.push(waEl);
                    } else {
                        clearError(waEl);
                        if(waEl.value !== waRaw) waEl.value = waRaw;
                    }
                } else {
                    clearError(waEl);
                }

                return { ok: firstInvalid.length === 0, firstInvalid: firstInvalid[0] || null, amount };
            }

            function setPayLoading(loading){
                const btn = q('#payBtn');
                const label = q('#payBtnLabel');
                const spinner = q('#paySpinner');
                if(!btn || !label || !spinner) return;
                btn.disabled = loading;
                spinner.classList.toggle('hidden', !loading);
                label.textContent = loading ? 'Memproses...' : 'Tunaikan Zakat Sekarang';
                btn.setAttribute('aria-busy', loading ? 'true' : 'false');
            }

            if(paymentForm){
                paymentForm.addEventListener('submit', (e) => {
                    e.preventDefault();
                    if(isSubmitting) return;
                    clearFeedback();
                    const { ok, firstInvalid, amount } = validatePayment();
                    if(!ok){
                        const box = q('#payment-feedback');
                        if((Number(q('#paymentAmountValue').value) || 0) <= 0 && box && box.classList.contains('hidden')){
                            setFeedback('error', 'Nominal zakat masih Rp 0. Isi form kalkulator hingga muncul nominal, lalu coba lagi.');
                        }
                        notify('Periksa kembali data pembayaran yang ditandai.', 'error');
                        if(firstInvalid) firstInvalid.focus();
                        const fb = q('#payment-feedback');
                        if(fb && !fb.classList.contains('hidden')) fb.focus({ preventScroll: false });
                        return;
                    }
                    isSubmitting = true;
                    setPayLoading(true);
                    const methodEl = document.querySelector('input[name="method"]:checked');
                    const method = methodEl ? methodEl.value : 'va';
                    // Simulasi persiapan pembayaran + guard double-submit; ganti dengan integrasi payment sebenarnya
                    setTimeout(() => {
                        setPayLoading(false);
                        isSubmitting = false;
                        setFeedback('success', 'Siap dibayar: ' + toRupiah(amount) + ' via ' + (method === 'ewallet' ? 'E-Wallet' : 'Virtual Account') + '. Lanjutkan ke langkah pembayaran.');
                        notify('Nominal ' + toRupiah(amount) + ' siap dibayar.', 'success');
                        q('#payment-feedback').focus({ preventScroll: false });
                    }, 500);
                });
                ['#pay_name', '#pay_email', '#pay_whatsapp'].forEach(sel => {
                    const el = q(sel);
                    if(el) el.addEventListener('input', () => { clearError(el); clearFeedback(); });
                });
            }
        </script>
    </section>
</PrimaryLayout>
