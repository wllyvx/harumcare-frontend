---
import PrimaryLayout from "../layouts/PrimaryLayout.astro";
import LatestCampaign from "../components/campaign/LatestCampaign.astro";
import Hero from "../components/home/Hero.astro";
import MenuIcons from "../components/home/MenuIcons.astro";
import LatestNews from "../components/news/LatestNews.astro";
import LatestBlog from "../components/blog/LatestBlog.astro";
import LatestKajian from "../components/kajian/LatestKajian.astro";

const API_URL = import.meta.env.PUBLIC_API_URL;

// fetch campaigns
async function fetchCampaigns() {
  try {
    const response = await fetch(`${API_URL}/campaigns`);
    if (!response.ok) {
      throw new Error("Failed to fetch campaigns");
    }
    const data = await response.json();

    return {
      campaigns: data.campaigns || [],
      totalPages: data.totalPages || 1,
      currentPage: data.currentPage || 1,
      total: data.total || 0,
    };
  } catch (error) {
    console.error("Error fetching campaigns:", error);
    return {
      campaigns: [],
      totalPages: 1,
      currentPage: 1,
      total: 0,
    };
  }
}

// fetch latest news
async function fetchLatestNews() {
  try {
    const response = await fetch(`${API_URL}/news?limit=3`);
    if (!response.ok) {
      throw new Error("Failed to fetch news");
    }
    const data = await response.json();

    return data.news || [];
  } catch (error) {
    console.error("Error fetching news:", error);
    return [];
  }
}

const [campaignData, latestNews] = await Promise.all([
  fetchCampaigns(),
  fetchLatestNews()
]);
---

<PrimaryLayout>
  <Hero news={latestNews} />
  <MenuIcons />
  <LatestNews />
  <LatestCampaign campaigns={campaignData.campaigns} />
  <LatestBlog />
  <LatestKajian />
</PrimaryLayout>
