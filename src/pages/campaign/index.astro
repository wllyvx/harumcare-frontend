---
import PrimaryLayout from "../../layouts/PrimaryLayout.astro";
import AllCampaign from "../../components/campaign/AllCampaign.astro";

const API_URL = import.meta.env.PUBLIC_API_URL;

interface Campaign {
  id: number;
  title: string;
  description: string;
  imageUrl: string;
  targetAmount: number;
  currentAmount: number;
  endDate: string;
  donorCount: number;
  organizationName: string;
  organizationLogo: string;
  category: string;
}

interface CampaignResponse {
  campaigns: Campaign[];
  totalPages: number;
  currentPage: number;
  total: number;
}

// Ambil parameter dari URL
const { searchParams } = Astro.url;
const page = Number(searchParams.get("page")) || 1;
const search = searchParams.get("search") || "";
const category = searchParams.get("category") || "";

// Fungsi fetch campaigns dengan pagination dan filter
// ok=false berarti gagal jaringan/server — bedakan dari hasil kosong yang valid.
async function fetchCampaigns(
  page = 1,
  limit = 12,
  search = "",
  category = "",
): Promise<CampaignResponse & { ok: boolean; errorMessage: string }> {
  try {
    const params = new URLSearchParams();
    params.append("page", page.toString());
    params.append("limit", limit.toString());
    if (search && search.trim() !== "") {
      params.append("search", search.trim());
    }
    if (category && category.trim() !== "") {
      params.append("category", category.trim());
    }

    const url = `${API_URL}/campaigns?${params.toString()}`;
    const response = await fetch(url);
    if (!response.ok) {
      throw new Error(`HTTP ${response.status}: gagal memuat kampanye`);
    }
    const data = await response.json();

    return {
      campaigns: data.campaigns || [],
      totalPages: data.totalPages || 1,
      currentPage: data.currentPage || 1,
      total: data.total || 0,
      ok: true,
      errorMessage: "",
    };
  } catch (error) {
    console.error("Error fetching campaigns:", error);
    return {
      campaigns: [],
      totalPages: 1,
      currentPage: 1,
      total: 0,
      ok: false,
      errorMessage:
        error instanceof Error ? error.message : "Gagal memuat kampanye",
    };
  }
}

async function fetchCategories(): Promise<string[]> {
  try {
    const res = await fetch(`${API_URL}/campaigns/categories`);
    if (!res.ok) throw new Error("categories endpoint unavailable");
    const data = await res.json();
    if (Array.isArray(data.categories)) {
      return data.categories.filter(Boolean).sort((a: string, b: string) => a.localeCompare(b));
    }
    return [];
  } catch {
    return [];
  }
}

// Fetch data dengan parameter yang ada
const campaignData = await fetchCampaigns(page, 12, search, category);

// Kategori dari endpoint khusus; fallback ke halaman saat ini bila endpoint belum tersedia.
let categories = await fetchCategories();
if (categories.length === 0) {
  categories = [...new Set(campaignData.campaigns.map((c) => c.category))]
    .filter(Boolean)
    .sort((a, b) => a.localeCompare(b));
}
---

<PrimaryLayout>
  <AllCampaign
    campaigns={campaignData.campaigns}
    totalPages={campaignData.totalPages}
    currentPage={campaignData.currentPage}
    total={campaignData.total}
    categories={categories}
    activeCategory={category}
    searchQuery={search}
    loadOk={campaignData.ok}
    loadError={campaignData.errorMessage}
  />
</PrimaryLayout>

<style>
  .campaign-section {
    background-color: #f9fafb;
  }
</style>
