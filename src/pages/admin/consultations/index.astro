---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { consultationCategories } from 'src/data/consultationCategories.js';

const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api';

let statusFilter = 'all';
let categoryFilter = '';
let searchQuery = '';
---

<AdminLayout title="Konsultasi">
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-3xl font-bold text-gray-900">Kelola Konsultasi</h2>
      <p class="text-sm text-gray-600">Lihat semua thread konsultasi dan jawab langsung dari admin panel.</p>
    </div>
    <div class="grid w-full gap-3 sm:auto-cols-min sm:grid-flow-col">
      <button id="refreshButton" class="rounded-full bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">Refresh</button>
    </div>
  </div>

  <div class="grid gap-4 lg:grid-cols-[1fr_auto]">
    <div class="grid gap-4">
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="space-y-2">
          <label class="block text-sm font-medium text-gray-700">Status</label>
          <select id="statusFilter" class="w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 focus:border-slate-500 focus:outline-none">
            <option value="all">Semua Status</option>
            <option value="pending">Pending</option>
            <option value="answered">Answered</option>
            <option value="closed">Closed</option>
          </select>
        </div>
        <div class="space-y-2">
          <label class="block text-sm font-medium text-gray-700">Kategori</label>
          <select id="categoryFilter" class="w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 focus:border-slate-500 focus:outline-none">
            <option value="">Semua Kategori</option>
            {consultationCategories.map((category) => (
              <option value={category.value}>{category.label}</option>
            ))}
          </select>
        </div>
        <div class="space-y-2">
          <label class="block text-sm font-medium text-gray-700">Cari</label>
          <input id="searchInput" type="text" placeholder="Cari judul atau isi..." class="w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 focus:border-slate-500 focus:outline-none" />
        </div>
      </div>

      <div id="alertBar" class="hidden rounded-2xl border border-emerald-100 bg-emerald-50 p-4 text-sm text-emerald-800"></div>

      <div id="loadingState" class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-slate-900 mx-auto mb-4"></div>
        <p class="text-gray-600">Memuat data konsultasi...</p>
      </div>

      <div id="errorState" class="hidden rounded-3xl border border-rose-200 bg-rose-50 p-8 text-center text-rose-700">
        <p>Gagal memuat konsultasi. Coba refresh halaman.</p>
      </div>

      <div id="consultationList" class="space-y-6"></div>
    </div>
  </div>
</AdminLayout>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api';

  const statusFilterEl = document.getElementById('statusFilter') as HTMLSelectElement | null;
  const categoryFilterEl = document.getElementById('categoryFilter') as HTMLSelectElement | null;
  const searchInputEl = document.getElementById('searchInput') as HTMLInputElement | null;
  const refreshButton = document.getElementById('refreshButton') as HTMLButtonElement | null;
  const consultationList = document.getElementById('consultationList');
  const loadingState = document.getElementById('loadingState');
  const errorState = document.getElementById('errorState');
  const alertBar = document.getElementById('alertBar');

  let statusFilter = 'all';
  let categoryFilter = '';
  let searchQuery = '';
  let searchTimeout: number | undefined;

  const formatDate = (dateInput: string | number | Date) => {
    try {
      const date = typeof dateInput === 'string' ? new Date(dateInput) : typeof dateInput === 'number' ? new Date(dateInput * 1000) : dateInput;
      return date.toLocaleString('id-ID', {
        day: '2-digit',
        month: 'long',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });
    } catch (err) {
      return '-';
    }
  };

  const showAlert = (message: string) => {
    if (!alertBar) return;
    alertBar.textContent = message;
    alertBar.classList.remove('hidden');
    window.setTimeout(() => alertBar.classList.add('hidden'), 4000);
  };

  const renderReplies = (replies: Array<any>) => {
    if (!replies || replies.length === 0) {
      return '<div class="rounded-2xl bg-slate-50 p-4 text-sm text-slate-600">Belum ada jawaban.</div>';
    }

    return replies.map((reply) => `
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
        <div class="mb-2 flex items-center justify-between gap-3 text-xs uppercase tracking-wide text-slate-500">
          <span>${reply.author?.role === 'admin' ? 'Admin HarumCare' : reply.author?.nama || 'Pengguna'}</span>
          <span>${formatDate(reply.createdAt)}</span>
        </div>
        <p class="text-sm leading-6 text-slate-700">${reply.content}</p>
      </div>
    `).join('');
  };

  const renderConsultationCard = (consultation: any) => {
    const authorLabel = consultation.isAnonymous ? (consultation.authorName || 'Anonim') : (consultation.author?.nama || 'Pengguna');
    return `
      <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <p class="text-sm text-slate-500">${consultation.category}</p>
            <h3 class="mt-2 text-xl font-semibold text-slate-900">${consultation.title}</h3>
          </div>
          <div class="space-y-2 text-right text-sm text-slate-600">
            <div>${formatDate(consultation.createdAt)}</div>
            <div class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs uppercase tracking-wide text-slate-700">${consultation.status}</div>
          </div>
        </div>

        <div class="mt-4 rounded-3xl bg-slate-50 p-5 text-sm leading-6 text-slate-700">
          <p>${consultation.content}</p>
        </div>

        <div class="mt-4 flex flex-col gap-3 text-sm text-slate-600">
          <div>Ditanyakan oleh: <strong>${authorLabel}</strong></div>
          <div>${renderReplies(consultation.replies || [])}</div>
        </div>

        <form class="reply-form mt-6 space-y-3" data-id="${consultation.id}">
          <label class="block text-sm font-medium text-slate-700">Balas Thread</label>
          <textarea name="replyContent" rows="4" class="w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-slate-900 focus:border-slate-500 focus:outline-none" placeholder="Tulis jawaban untuk pengguna..." required></textarea>
          <div class="flex flex-wrap gap-3">
            <button type="submit" class="inline-flex items-center justify-center rounded-full bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">Kirim Jawaban</button>
          </div>
        </form>
      </div>
    `;
  };

  const fetchConsultations = async () => {
    if (!loadingState || !consultationList || !errorState) return;
    loadingState.classList.remove('hidden');
    errorState.classList.add('hidden');
    consultationList.innerHTML = '';

    try {
      const token = localStorage.getItem('token');
      if (!token) {
        window.location.href = '/auth/login';
        return;
      }

      const params = new URLSearchParams({
        status: statusFilter,
        limit: '50'
      });
      if (categoryFilter) params.append('category', categoryFilter);
      if (searchQuery) params.append('q', searchQuery);

      const response = await fetch(`${API_URL}/consultations?${params.toString()}`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || 'Gagal memuat konsultasi');
      }

      if (!result.data || result.data.length === 0) {
        consultationList.innerHTML = '<div class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center text-slate-600">Tidak ada thread konsultasi.</div>';
      } else {
        // Fetch detailed consultations with replies
        const detailedConsultations = await Promise.all(
          result.data.map(async (consultation: any) => {
            try {
              const detailResponse = await fetch(`${API_URL}/consultations/${consultation.id}`, {
                headers: { 'Authorization': `Bearer ${token}` }
              });
              return await detailResponse.json();
            } catch (err) {
              return consultation;
            }
          })
        );
        consultationList.innerHTML = detailedConsultations.map(renderConsultationCard).join('');
      }

      attachReplyListeners();
    } catch (error) {
      console.error(error);
      errorState.classList.remove('hidden');
    } finally {
      loadingState.classList.add('hidden');
    }
  };

  const attachReplyListeners = () => {
    document.querySelectorAll<HTMLFormElement>('.reply-form').forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const replyForm = event.currentTarget as HTMLFormElement;
        const consultationId = replyForm.dataset.id;
        const textarea = replyForm.querySelector<HTMLTextAreaElement>('textarea[name="replyContent"]');

        if (!textarea || !consultationId) return;
        const content = textarea.value.trim();
        if (!content) return;

        try {
          const token = localStorage.getItem('token');
          if (!token) {
            window.location.href = '/auth/login';
            return;
          }

          const response = await fetch(`${API_URL}/consultations/${consultationId}/replies`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ content })
          });

          const result = await response.json();
          if (!response.ok) {
            throw new Error(result.error || 'Gagal mengirim jawaban');
          }

          showAlert('Jawaban berhasil dikirim. Thread telah diperbarui.');
          textarea.value = '';
          fetchConsultations();
        } catch (error) {
          console.error(error);
          showAlert('Terjadi kesalahan saat mengirim jawaban.');
        }
      });
    });
  };

  document.addEventListener('DOMContentLoaded', () => {
    if (statusFilterEl) {
      statusFilterEl.addEventListener('change', () => {
        statusFilter = statusFilterEl.value;
        fetchConsultations();
      });
    }

    if (categoryFilterEl) {
      categoryFilterEl.addEventListener('change', () => {
        categoryFilter = categoryFilterEl.value;
        fetchConsultations();
      });
    }

    if (searchInputEl) {
      searchInputEl.addEventListener('input', () => {
        searchQuery = searchInputEl.value;
        if (searchTimeout) window.clearTimeout(searchTimeout);
        searchTimeout = window.setTimeout(fetchConsultations, 400);
      });
    }

    refreshButton?.addEventListener('click', fetchConsultations);
    fetchConsultations();
  });
</script>
