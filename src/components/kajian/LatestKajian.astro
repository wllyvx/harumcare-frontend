---
import KajianCard from "./KajianCard.astro";

// Kajian interface
interface Kajian {
  id: string;
  title: string;
  description: string;
  youtubeLink: string;
  slug: string;
  author?: {
    nama: string;
    username: string;
  };
  category: string;
  createdAt: string;
  viewCount: number;
}

// Props interface
interface Props {
  title?: string;
  subtitle?: string;
  limit?: number;
  showViewAll?: boolean;
  viewAllLink?: string;
}

const {
  title = "Kajian Terbaru",
  subtitle = "Dengarkan kajian terbaru dari para ustadz dan ahli agama",
  limit = 6,
  showViewAll = true,
  viewAllLink = "/kajian"
} = Astro.props;

// Fetch latest kajians from API
let latestKajians: Kajian[] = [];
try {
  const response = await fetch(`${import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api'}/kajian/latest?limit=${limit}`);
  if (response.ok) {
    latestKajians = await response.json();
  }
} catch (error) {
  console.error('Error fetching latest kajians:', error);
}
---

<section class="kajian-section px-4 py-8 md:py-16">
  <div class="kajian-container max-w-7xl mx-auto">
    <!-- Header Section -->
    <h2 class="bg-blue-500 text-white text-lg rounded-t-lg w-fit px-3 py-1 font-semibold mb-4">{title}</h2>

    <!-- Kajian Cards -->
    {latestKajians.length > 0 ? (
      <div class="kajian-scroll-container">
        <div class="kajian-scroll-wrapper">
          {latestKajians.map((kajian: Kajian) => (
            <KajianCard
              id={kajian.id}
              title={kajian.title}
              description={kajian.description}
              youtubeLink={kajian.youtubeLink}
              slug={kajian.slug}
              author={kajian.author}
              category={kajian.category}
              createdAt={kajian.createdAt}
              viewCount={kajian.viewCount}
            />
          ))}
        </div>
      </div>
    ) : (
      <div class="text-center py-12">
        <div class="mb-4">
          <img
            src="/images/empty-image-placeholder.webp"
            alt="No kajian"
            class="w-32 h-32 mx-auto opacity-50"
          />
        </div>
        <h3 class="text-xl font-semibold text-gray-700 mb-2">Belum Ada Kajian</h3>
        <p class="text-gray-500">Kajian terbaru akan muncul di sini</p>
      </div>
    )}

    <!-- View All Button -->
    {showViewAll && latestKajians.length > 0 && (
      <div class="text-center mt-12">
        <a
          href={viewAllLink}
          class="inline-block px-8 py-3 text-blue-600 border border-blue-600 rounded-full hover:bg-blue-600 hover:text-white transition-colors duration-300 font-medium"
        >
          Lihat Semua Kajian
        </a>
      </div>
    )}
  </div>
</section>