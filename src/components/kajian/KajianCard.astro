---
interface Props {
  id: string;
  title: string;
  description: string;
  youtubeLink: string;
  slug: string;
  author?: {
    nama: string;
    username: string;
  };
  category: string;
  createdAt: string;
  viewCount: number;
}

const {
  id,
  title,
  description,
  youtubeLink,
  slug,
  author,
  category,
  createdAt,
  viewCount,
} = Astro.props;

// Format tanggal
const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString("id-ID", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

// Extract video ID from YouTube URL
const extractVideoId = (url: string) => {
  const patterns = [
    /(?:https?:\/\/)?(?:www\.)?youtube\.com\/watch\?v=([^&\n?#]+)/,
    /(?:https?:\/\/)?(?:www\.)?youtu\.be\/([^&\n?#]+)/,
    /(?:https?:\/\/)?(?:www\.)?youtube\.com\/live\/([^&\n?#]+)/
  ];
  for (const pattern of patterns) {
    const match = url.match(pattern);
    if (match) return match[1];
  }
  return null;
};

const videoId = extractVideoId(youtubeLink);
const thumbnailUrl = videoId ? `https://img.youtube.com/vi/${videoId}/hqdefault.jpg` : "/images/empty-image-placeholder.webp";

// Truncate description untuk preview
const truncateContent = (text: string, maxLength: number = 150) => {
  if (!text) return "";
  if (text.length <= maxLength) return text;
  return text.substring(0, maxLength) + "...";
};
---

<article
  class="kajian-card-compact group cursor-pointer transition-all duration-300 hover:-translate-y-1 flex-shrink-0"
>
  <a href={`/kajian/${slug}`} class="block h-full">
    <div
      class="bg-white rounded-lg overflow-hidden border border-gray-100 hover:border-gray-200 shadow-sm hover:shadow-md h-full flex flex-col"
    >
      <!-- Thumbnail Section -->
      <div
        class="kajian-image-container-compact relative overflow-hidden flex-shrink-0"
      >
        <img
          src={thumbnailUrl}
          alt={title}
          class="w-full h-32 object-cover transition-transform duration-500 group-hover:scale-105"
          onerror="this.onerror=null; this.src='/images/empty-image-placeholder.webp'"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-20 transition-all duration-300"></div>
        <div class="absolute top-2 left-2">
          <span
            class="text-xs bg-white/90 text-gray-700 px-2 py-1 rounded-full font-medium shadow-sm"
          >
            {category}
          </span>
        </div>
        <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          <div class="bg-red-600 rounded-full p-2">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </div>
        </div>
      </div>

      <!-- Content Section -->
      <div class="kajian-content-compact p-4 flex flex-col flex-grow">
        <!-- Meta Info -->
        <div
          class="kajian-meta-compact flex items-center gap-2 mb-2 flex-shrink-0"
        >
          <div class="author-info-compact flex items-center gap-1.5">
            <img
              src="/images/icons/user-default.svg"
              alt="Author"
              class="w-6 h-6 rounded-full border border-gray-100"
            />
            <div class="flex flex-col">
              <p class="text-xs font-medium text-gray-900">
                {author?.nama || "Anonymous"}
              </p>
              <span class="text-xs text-gray-500">
                {formatDate(createdAt)}
              </span>
            </div>
          </div>

          <div
            class="view-count-compact ml-auto flex items-center gap-1 text-xs text-gray-500"
          >
            <svg
              class="w-3 h-3"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
              ></path>
            </svg>
            {viewCount}
          </div>
        </div>

        <!-- Title -->
        <h3
          class="text-sm font-bold text-gray-900 mb-2 leading-tight group-hover:text-blue-600 transition-colors duration-300 line-clamp-2 flex-shrink-0"
        >
          {title}
        </h3>

        <!-- Description Preview -->
        <p
          class="text-xs text-gray-600 leading-relaxed line-clamp-2 flex-grow"
        >
          {truncateContent(description, 100)}
        </p>
      </div>
    </div>
  </a>
</article>