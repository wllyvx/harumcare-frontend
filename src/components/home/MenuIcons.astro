---
type MenuItem = {
  href: string;
  label: string;
  icon: string; // Material Symbol icon name
  highlight?: boolean;
};

const menus: MenuItem[] = [
  {
    href: "/campaign",
    label: "Mulai Berdonasi",
    icon: "volunteer_activism",
    highlight: true,
  },
  { href: "/news", label: "Wawasan", icon: "auto_stories" },
  { href: "/pojok-konsultasi", label: "Konsultasi", icon: "forum" },
];
---

<section class="w-full bg-white py-8 md:py-10 border-y border-border/60">
  <div class="max-w-3xl mx-auto px-4">
    <div class="grid grid-cols-3 gap-3 md:gap-4">
      {
        menus.map((menu) => (
          <a
            href={menu.href}
            class={`group flex flex-col items-center justify-center p-5 md:p-7 rounded-2xl border transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2 ${
              menu.highlight
                ? "bg-brand-700 border-brand-700 text-white hover:bg-brand-800 hover:border-brand-800 hover:-translate-y-0.5 hover:shadow-[0_8px_24px_rgba(29,78,216,0.18)]"
                : "bg-white border-border hover:border-brand-300 hover:-translate-y-0.5 hover:shadow-sm"
            }`}
            aria-label={menu.label}
          >
            <span class={`material-symbols-outlined text-4xl md:text-[2.5rem] mb-3 ${menu.highlight ? "text-white" : "text-brand-600"}`} aria-hidden="true">{menu.icon}</span>
            <span class={`text-sm md:text-[0.95rem] font-semibold text-center leading-tight ${menu.highlight ? "text-white" : "text-foreground"}`}>
              {menu.label}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
