---
type MenuItem = {
  href: string;
  label: string;
  icon: string; // Material Symbol icon name
  highlight?: boolean;
};

const menus: MenuItem[] = [
  {
    href: "/campaign",
    label: "Mulai Berdonasi",
    icon: "favorite",
    highlight: true,
  },
  { href: "/news", label: "Wawasan", icon: "auto_stories" },
  { href: "/pojok-konsultasi", label: "Konsultasi", icon: "help_center" },
];
---

<>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL@24,400,0" />
</>

<section class="w-full bg-white py-8 md:py-10 border-y border-border/60">
  <div class="max-w-3xl mx-auto px-4">
    <div class="grid grid-cols-3 gap-3 md:gap-4">
      {
        menus.map((menu) => (
          <a
            href={menu.href}
            class={`group flex flex-col items-center justify-center p-5 md:p-7 rounded-2xl border transition-all duration-200 ${
              menu.highlight
                ? "bg-brand-600 border-brand-600 text-white hover:bg-[#1e3a8a] hover:border-[#1e3a8a] hover:-translate-y-0.5"
                : "bg-white border-border hover:border-brand-300 hover:-translate-y-0.5 hover:shadow-sm"
            }`}
            aria-label={menu.label}
          >
            <span class={`material-symbols-rounded text-4xl md:text-[2.5rem] mb-3 ${menu.highlight ? "text-white" : "text-brand-600"}`}>{menu.icon}</span>
            <span class={`text-sm md:text-[0.95rem] font-semibold text-center leading-tight ${menu.highlight ? "text-white" : "text-foreground"}`}>
              {menu.label}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
