---
const { news = [] } = Astro.props;
const heroImage = news?.[0]?.image || "/images/slide1.jpg";
---

<section class="relative w-full h-[56vh] min-h-[420px] md:h-[58vh] md:min-h-[480px] overflow-hidden bg-foreground">
  <img src={heroImage} alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager" aria-hidden="true" />
  <div class="absolute inset-0 bg-foreground/55"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-foreground/30 via-transparent to-transparent"></div>
  <div class="relative z-10 flex flex-col items-center justify-center h-full text-center px-4 py-12">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-[2rem] sm:text-5xl md:text-6xl font-bold leading-[1.05] tracking-tight text-white text-balance">
        Hadirkan Kebaikan di Hati Anda
      </h1>
      <p class="text-[15px] sm:text-lg md:text-xl text-white/85 mt-5 max-w-2xl mx-auto leading-relaxed">
        Bersama HarumCare, wujudkan dampak positif untuk masyarakat
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center mt-8">
        <a href="/campaign" class="inline-flex items-center justify-center px-8 py-3.5 bg-[#1d4ed8] hover:bg-[#1e3a8a] text-white font-semibold rounded-lg transition-colors shadow-lg shadow-blue-900/20">
          Mulai Berdonasi
        </a>
        <a href="/kajian" class="inline-flex items-center justify-center px-8 py-3.5 bg-white text-foreground font-semibold rounded-lg hover:bg-white/90 transition-colors">
          Jelajahi Kajian
        </a>
      </div>
    </div>
  </div>
</section>
