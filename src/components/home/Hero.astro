---
const { news = [] } = Astro.props;
const heroImage = news?.[0]?.image || "/images/slide1.jpg";
---

<section class="relative w-full h-[56vh] min-h-[420px] md:h-[58vh] md:min-h-[480px] overflow-hidden bg-foreground isolate">
  <img src={heroImage} alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" aria-hidden="true" onerror="this.style.display='none'" />
  <div class="absolute inset-0 bg-foreground/55" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-foreground/30 via-transparent to-transparent" aria-hidden="true"></div>
  <div class="relative z-10 flex flex-col items-center justify-center h-full text-center px-4 py-12">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-[2rem] sm:text-5xl md:text-6xl font-bold leading-[1.05] tracking-tight text-white text-balance [text-shadow:0_1px_16px_rgba(0,0,0,0.22)]">
        Hadirkan Kebaikan di Hati Anda
      </h1>
      <p class="text-[15px] sm:text-lg md:text-xl text-white/85 mt-5 max-w-2xl mx-auto leading-relaxed text-balance">
        Bersama HarumCare, wujudkan dampak positif untuk masyarakat
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center mt-8">
        <a href="/campaign" class="inline-flex items-center justify-center px-8 py-3.5 bg-brand-700 hover:bg-brand-800 text-white font-semibold rounded-button transition-all duration-200 shadow-lg shadow-brand-900/20 hover:-translate-y-0.5 hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60 focus-visible:ring-offset-2 focus-visible:ring-offset-brand-700">
          Mulai Berdonasi
        </a>
        <a href="/kajian" class="inline-flex items-center justify-center px-8 py-3.5 bg-white text-foreground font-semibold rounded-button hover:bg-white/90 transition-all duration-200 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60 focus-visible:ring-offset-2 focus-visible:ring-offset-foreground/60">
          Jelajahi Kajian
        </a>
      </div>
    </div>
  </div>
</section>
