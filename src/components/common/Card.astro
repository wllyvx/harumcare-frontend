---
// Props untuk komponen card donasi
interface Props {
  id: number;
  title: string;
  description: string;
  imageUrl: string;
  targetAmount: number;
  currentAmount: number;
  daysLeft: number;
  donorCount: number;
  organizationName: string;
  organizationLogo: string;
  category: string;
}

const {
  id,
  title,
  description,
  imageUrl,
  targetAmount,
  currentAmount,
  daysLeft,
  donorCount,
  organizationName,
  organizationLogo,
  category,
} = Astro.props;

// Hitung persentase donasi yang sudah terkumpul
const percentageFunded = Math.min(
  Math.round((currentAmount / targetAmount) * 100),
  100,
);

// Format angka ke format mata uang Rupiah
const formatCurrency = (amount: number) => {
  return new Intl.NumberFormat("id-ID", {
    style: "currency",
    currency: "IDR",
    minimumFractionDigits: 0,
    maximumFractionDigits: 0,
  }).format(amount);
};

// Trim deskripsi jika terlalu panjang
const trimmedDescription =
  description.length > 120
    ? `${description.substring(0, 120)}...`
    : description;

import {
  Card as ShadCard,
  CardContent,
  CardFooter,
} from "@/components/components/ui/card";
import Button from "@/components/common/Button.astro";
---

<a href={`/campaign/${id}`} class="block h-full">
  <ShadCard
    className="max-w-sm h-full group hover:shadow-xl transition-all duration-300 cursor-pointer"
  >
    <div class="relative shrink-0">
      <img
        src={imageUrl}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-all duration-300"
        loading="lazy"
      />
      <span
        class="absolute top-4 left-4 bg-brand-600 text-white px-3 py-1 rounded-full text-xs font-medium"
      >
        {category}
      </span>
    </div>

    <CardContent className="p-5 flex flex-col grow">
      <div class="mb-4 grow">
        <h3
          class="font-bold text-xl mb-2 text-gray-800 group-hover:text-brand-600 transition-colors duration-200 line-clamp-2"
        >
          {title}
        </h3>
        <p class="text-gray-600 text-sm mb-4 line-clamp-3">
          {trimmedDescription}
        </p>

        <div class="w-full bg-gray-200 rounded-full h-2.5 mb-2">
          <div
            class="bg-brand-600 h-2.5 rounded-full"
            style={`width: ${percentageFunded}%`}
          >
          </div>
        </div>

        <div class="flex justify-between text-sm mb-4">
          <span class="font-semibold text-brand-700"
            >{formatCurrency(currentAmount)}</span
          >
          <span class="text-gray-500">dari {formatCurrency(targetAmount)}</span>
        </div>
      </div>

      <div class="grid grid-cols-3 gap-2 mb-4 text-center shrink-0">
        <div class="bg-gray-50 p-2 rounded">
          <p class="text-xs text-gray-500">Terkumpul</p>
          <p class="font-semibold text-gray-800">{percentageFunded}%</p>
        </div>
        <div class="bg-gray-50 p-2 rounded">
          <p class="text-xs text-gray-500">Donatur</p>
          <p class="font-semibold text-gray-800">{donorCount}</p>
        </div>
        <div class="bg-gray-50 p-2 rounded">
          <p class="text-xs text-gray-500">Sisa Hari</p>
          <p class="font-semibold text-gray-800">{daysLeft}</p>
        </div>
      </div>
    </CardContent>

    <CardFooter className="flex flex-col items-center justify-between">
      <div class="flex items-left align-middle w-full">
        <img
          src={organizationLogo
            ? organizationLogo
            : "/images/icons/user-default.svg"}
          alt={organizationName}
          class="w-8 h-8 rounded-full mr-2 object-cover"
        />
        <span class="text-sm align-middle text-gray-600"
          >Oleh <span class="font-medium">{organizationName}</span></span
        >
      </div>

      <div class="shrink-0 w-full mt-4">
        <Button className="w-full" variant="default">Donasi Sekarang</Button>
      </div>
    </CardFooter>
  </ShadCard>
</a>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
