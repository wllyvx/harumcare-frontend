---
// Props untuk komponen card donasi
interface Props {
  id: number;
  title: string;
  description: string;
  imageUrl: string;
  targetAmount: number;
  currentAmount: number;
  daysLeft: number;
  isEnded?: boolean;
  donorCount: number;
  organizationName: string;
  organizationLogo: string;
  category: string;
}

const {
  id,
  title,
  description,
  imageUrl,
  targetAmount,
  currentAmount,
  daysLeft,
  isEnded = false,
  donorCount,
  organizationName,
  organizationLogo,
  category,
} = Astro.props;

// Hitung persentase donasi yang sudah terkumpul
const percentageFunded = Math.min(
  Math.round((currentAmount / targetAmount) * 100),
  100,
);

// Format angka ke format mata uang Rupiah
const formatCurrency = (amount: number) => {
  return new Intl.NumberFormat("id-ID", {
    style: "currency",
    currency: "IDR",
    minimumFractionDigits: 0,
    maximumFractionDigits: 0,
  }).format(amount);
};

// Trim deskripsi jika terlalu panjang
const trimmedDescription =
  description.length > 120
    ? `${description.substring(0, 120)}...`
    : description;

import {
  Card as ShadCard,
  CardContent,
  CardFooter,
} from "@/components/components/ui/card";
---

<article class="block h-full">
  <ShadCard
    className="w-full h-full group hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 overflow-hidden p-0 gap-0 border-border rounded-[16px] shadow-sm"
  >
    <div class="relative shrink-0 aspect-video overflow-hidden">
      <a href={`/campaign/${id}`} aria-label={`Lihat kampanye: ${title}`} class="block w-full h-full">
        <img
          src={imageUrl}
          alt=""
          aria-hidden="true"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
          onerror="this.src='/images/empty-image-placeholder.webp'"
        />
      </a>
      <span
        class="absolute top-4 left-4 bg-brand-600 text-white px-3 py-1 rounded-full text-xs font-medium"
      >
        {category}
      </span>
      {isEnded && (
        <span class="absolute top-4 right-4 bg-neutral-900/85 text-white px-3 py-1 rounded-full text-xs font-semibold">
          Berakhir
        </span>
      )}
    </div>

    <CardContent className="p-5 flex flex-col grow">
      <div class="mb-4 grow">
        <h3
          class="font-semibold text-[1.125rem] leading-snug mb-2 text-foreground transition-colors duration-200 line-clamp-2"
        >
          <a href={`/campaign/${id}`} class="hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 rounded-sm">
            {title}
          </a>
        </h3>
        <p class="text-muted-foreground text-sm mb-4 line-clamp-3 leading-relaxed">
          {trimmedDescription}
        </p>

        <div class="w-full bg-muted rounded-full h-2.5 mb-2 overflow-hidden">
          <div
            class="bg-brand-600 h-2.5 rounded-full transition-all duration-500"
            style={`width: ${percentageFunded}%`}
            role="progressbar"
            aria-valuenow={percentageFunded}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-label={`Terkumpul ${percentageFunded}%`}
          >
          </div>
        </div>

        <div class="flex justify-between text-sm mb-4">
          <span class="font-semibold text-brand-700"
            >{formatCurrency(currentAmount)}</span
          >
          <span class="text-muted-foreground">dari {formatCurrency(targetAmount)}</span>
        </div>
      </div>

      <div class="grid grid-cols-3 gap-2 mb-4 text-center shrink-0">
        <div class="bg-muted p-2.5 rounded-lg">
          <p class="text-xs text-muted-foreground">Terkumpul</p>
          <p class="font-semibold text-foreground text-sm mt-0.5 tabular-nums">{percentageFunded}%</p>
        </div>
        <div class="bg-muted p-2.5 rounded-lg">
          <p class="text-xs text-muted-foreground">Donatur</p>
          <p class="font-semibold text-foreground text-sm mt-0.5 tabular-nums">{donorCount}</p>
        </div>
        <div class="bg-muted p-2.5 rounded-lg">
          <p class="text-xs text-muted-foreground">Sisa Hari</p>
          <p class="font-semibold text-foreground text-sm mt-0.5 tabular-nums">{isEnded ? "0" : daysLeft}</p>
        </div>
      </div>
    </CardContent>

    <CardFooter className="flex flex-col items-center justify-between p-5 pt-0">
      <div class="flex items-center w-full">
        <img
          src={organizationLogo
            ? organizationLogo
            : "/images/icons/user-default.svg"}
          alt=""
          aria-hidden="true"
          class="w-8 h-8 rounded-full mr-2 object-cover shrink-0"
          loading="lazy"
          onerror="this.src='/images/icons/user-default.svg'"
        />
        <span class="text-sm text-muted-foreground truncate"
          >Oleh <span class="font-medium text-foreground">{organizationName}</span></span
        >
      </div>

      <div class="shrink-0 w-full mt-4">
        <a
          href={isEnded ? undefined : `/campaign/${id}#donasi`}
          aria-disabled={isEnded ? "true" : undefined}
          class={`w-full inline-flex items-center justify-center min-h-11 px-4 py-2.5 rounded-button font-semibold text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2 ${
            isEnded
              ? "bg-muted text-muted-foreground cursor-not-allowed pointer-events-none"
              : "bg-brand-700 hover:bg-brand-800 text-white shadow-sm"
          }`}
        >
          {isEnded ? "Kampanye Berakhir" : "Donasi Sekarang"}
        </a>
      </div>
    </CardFooter>
  </ShadCard>
</article>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
