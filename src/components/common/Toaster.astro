---
import { Toaster as SonnerToaster } from "@/components/components/ui/sonner";
---

<SonnerToaster client:load />

<script>
  import { toast } from "sonner";

  // Expose showToast to window for global access
  (window as any).showToast = (
    message: string,
    type: "success" | "error" | "warning" | "default" = "success",
    timeout = 4000,
  ) => {
    const options = { duration: timeout };

    switch (type) {
      case "success":
        toast.success(message, options);
        break;
      case "error":
        toast.error(message, options);
        break;
      case "warning":
        toast.warning(message, options);
        break;
      case "default":
      default:
        toast(message, options);
        break;
    }
  };
</script>
