---
import NavLink from "@/components/common/NavLink.astro";
---

<header class="bg-white shadow-md sticky top-0 z-50">
  <div class="container mx-auto px-4">
    <nav class="flex items-center justify-between h-16">
      <!-- logo -->
      <div class="shrink-0">
        <a href="/" class="flex items-center">
          <img
            src="/images/logo/logo.png"
            alt="Logo Harum Care"
            class="h-8 w-auto mr-2"
          />
        </a>
      </div>

      <!-- menu desktop -->
      <div class="hidden md:block">
        <ul class="flex space-x-8">
          <li>
            <a
              href="/"
              class="text-gray-700 hover:text-brand-600 font-medium transition duration-200"
              >Beranda</a
            >
          </li>
          <li>
            <a
              href="/campaign"
              class="text-gray-700 hover:text-brand-600 font-medium transition duration-200"
              >Mulai Berdonasi</a
            >
          </li>
          <li>
            <a
              href="/news"
              class="text-gray-700 hover:text-brand-600 font-medium transition duration-200"
              >Berita</a
            >
          </li>
          <li>
            <a
              href="/blog"
              class="text-gray-700 hover:text-brand-600 font-medium transition duration-200"
              >Blog</a
            >
          </li>
        </ul>
      </div>

      <!-- tombol aksi desktop -->
      <div id="auth-nav" class="hidden md:flex items-center space-x-3">
        <!-- placeholder javascript -->
        <span class="text-gray-600">Loading...</span>
      </div>
    </nav>
  </div>
</header>

<!-- Mobile Navigation Bar - Sticky Bottom -->
<div
  class="md:hidden fixed bottom-0 left-0 right-0 bg-white border-t border-gray-100 shadow-[0_-4px_10px_rgba(0,0,0,0.05)] z-50 h-20"
>
  <div class="flex items-center justify-around h-full px-2">
    <!-- Home -->
    <NavLink href="/" label="Beranda" class="w-16">
      <span slot="icon" class="material-symbols-outlined text-2xl mb-1"
        >home</span
      >
    </NavLink>

    <!-- News -->
    <NavLink href="/news" label="Berita" class="w-16">
      <span slot="icon" class="material-symbols-outlined text-2xl mb-1"
        >newspaper</span
      >
    </NavLink>

    <!-- Focal Point: Mulai Berdonasi -->
    <div class="relative -top-6">
      <a href="/campaign" class="flex flex-col items-center group">
        <div
          class="w-16 h-16 bg-brand-600 text-white rounded-full flex items-center justify-center shadow-[0_8px_20px_rgba(37,99,235,0.4)] mb-1 ring-4 ring-white transition-all duration-300 group-hover:scale-105 group-hover:shadow-[0_10px_25px_rgba(37,99,235,0.5)] active:scale-95"
        >
          <span class="material-symbols-outlined text-3xl"
            >volunteer_activism</span
          >
        </div>
        <span
          class="text-[10px] font-bold text-brand-600 text-center leading-tight uppercase tracking-tighter"
          >Berdonasi</span
        >
      </a>
    </div>

    <!-- Blog -->
    <NavLink href="/blog" label="Blog" class="w-16">
      <span slot="icon" class="material-symbols-outlined text-2xl mb-1"
        >article</span
      >
    </NavLink>

    <!-- Profile -->
    <a
      href="/profile"
      class="w-16 flex flex-col items-center text-gray-600 hover:text-brand-600 transition duration-200"
    >
      <span class="material-symbols-outlined text-2xl mb-1">account_circle</span
      >
      <span class="text-xs">Profil</span>
    </a>
  </div>
</div>

<script>
  // Fungsi untuk memperbarui navigasi berdasarkan status login
  function updateNav() {
    const authNav = document.querySelector("#auth-nav");
    const userToken = localStorage.getItem("token");
    const userRole = localStorage.getItem("role");

    console.log("Updating nav - userToken:", userToken, "userRole:", userRole);

    if (authNav) {
      if (userToken) {
        const userName = localStorage.getItem("userName") || "User";
        const displayName =
          userRole === "admin" ? `Admin ${userName}` : userName;
        authNav.innerHTML = `
          <span class="py-4 px-2 text-gray-500">Selamat Datang, ${displayName}</span>
          <a href="/profile" class="py-2 px-4 bg-brand-600 text-white font-semibold rounded-button hover:bg-brand-700 transition duration-300">Profil</a>
        `;
      } else {
        authNav.innerHTML = `
          <a href="/profile" class="py-2 px-4 font-medium text-white bg-brand-600 rounded-button hover:bg-brand-700 transition duration-300">Profil</a>
        `;
      }
    }
  }

  // Panggil updateNav saat halaman dimuat
  window.addEventListener("load", () => {
    updateNav();
  });

  // Perbarui navigasi jika localStorage berubah
  window.addEventListener("storage", updateNav);

  // Perbarui navigasi saat kembali ke halaman
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) {
      console.log("Page loaded from cache, updating nav...");
      updateNav();
    }
  });
</script>
