---
interface ConsultationReply {
  id: string;
  content: string;
  createdAt: number;
  author?: {
    nama?: string;
    role?: string;
  };
}

interface Consultation {
  id: string;
  title: string;
  content: string;
  category: string;
  status: string;
  createdAt: number;
  isAnonymous: boolean;
  authorName?: string;
  author?: {
    nama?: string;
  };
  replies?: ConsultationReply[];
}

const { consultation } = Astro.props as { consultation: Consultation };
const authorLabel = consultation.isAnonymous ? (consultation.authorName || 'Anonim') : (consultation.author?.nama || 'Pengguna');
const formatDate = (dateInput: string | number | Date) => {
  try {
    let date: Date;
    if (typeof dateInput === 'string') date = new Date(dateInput);
    else if (typeof dateInput === 'number') date = new Date(dateInput < 1e12 ? dateInput * 1000 : dateInput);
    else date = dateInput;
    return date.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
  } catch (e) {
    return '-';
  }
};
const statusKey = String(consultation.status || '').toLowerCase();
const isAnswered = ['answered', 'closed', 'resolved'].includes(statusKey) || (consultation.replies?.length || 0) > 0;
const statusLabel = isAnswered ? 'Sudah dijawab' : 'Menunggu jawaban';
const categoryLabel = String(consultation.category || '').charAt(0).toUpperCase() + String(consultation.category || '').slice(1);
const toISO = (v: string | number | Date) => {
  try {
    let d: Date;
    if (typeof v === 'string') d = new Date(v);
    else if (typeof v === 'number') d = new Date(v < 1e12 ? v * 1000 : v);
    else d = v;
    return isNaN(d.getTime()) ? undefined : d.toISOString();
  } catch { return undefined; }
};
---
<article class="rounded-2xl border border-[#ebebeb] bg-white p-6 shadow-sm sm:p-8">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3 text-sm text-[#737373]">
    <span class="inline-flex min-h-11 items-center gap-2 font-semibold text-[#525252]"><span aria-hidden="true" class="inline-block h-2 w-2 rounded-full bg-[#1d4ed8]"></span>{categoryLabel}<span class="sr-only">, status: {statusLabel}</span></span>
    <div class="flex items-center gap-2">
      <time datetime={toISO(consultation.createdAt)}>{formatDate(consultation.createdAt)}</time>
      <span class={`inline-flex min-h-11 items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold ${isAnswered ? 'bg-[#dbeafe] text-[#1e3a8a]' : 'bg-[#fffbeb] text-[#92400e] ring-1 ring-[#f59e0b]/40'}`}>{isAnswered ? (<svg aria-hidden="true" width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M3.5 8.2l3 3 6-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>) : null}{statusLabel}</span>
    </div>
  </div>

  <p class="max-w-[68ch] text-sm leading-7 text-[#525252] sm:text-base">{consultation.content}</p>
  <div aria-hidden="true" class="mt-6 flex items-center gap-3 text-[#dbeafe]"><span class="h-px flex-1 bg-[#ebebeb]"></span><span class="text-xs tracking-widest text-[#737373]">· AMANAH ·</span><span class="h-px flex-1 bg-[#ebebeb]"></span></div>

  <div class="mt-6 rounded-2xl border border-[#ebebeb] bg-[#f5f5f5] p-4 text-sm text-[#525252]">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <span>Ditanyakan oleh: <strong class="text-[#252525]">{authorLabel}</strong></span>
      <span class="text-xs text-[#737373]">Privasi Anda dijaga — nama hanya tampil sebagai Anonim bila Anda memilihnya.</span>
    </div>
  </div>

  {consultation.replies?.length ? (
    <div class="mt-8 space-y-4">
      <h2 class="text-base font-bold text-[#252525]">Jawaban Admin</h2>
      {consultation.replies.map((reply) => (
        <div class="rounded-2xl border border-[#dbeafe] bg-[#eff6ff] p-5 shadow-sm">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2 text-xs text-[#1e3a8a]">
            <span class="inline-flex min-h-11 items-center gap-2 font-bold uppercase tracking-wide">
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="8" fill="#1d4ed8"/><path d="M5 8.2l2 2 4-4.4" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {reply.author?.role === 'admin' ? 'Admin HarumCare · Terverifikasi · Amanah' : reply.author?.nama || 'Pengguna'}
            </span>
            <time class="font-medium normal-case tracking-normal" datetime={toISO(reply.createdAt)}>{formatDate(reply.createdAt)}</time>
          </div>
          <p class="max-w-[68ch] text-sm leading-7 text-[#252525]">{reply.content}</p>
        </div>
      ))}
    </div>
  ) : (
    <div class="mt-6 rounded-2xl border border-[#f59e0b]/30 bg-[#fffbeb] p-5 text-sm leading-6 text-[#78350f]">
      <p class="font-semibold">Belum ada jawaban — pertanyaan sudah diterima.</p>
      <ol class="mt-3 space-y-2" aria-label="Alur jawaban">
        <li class="flex items-center gap-2"><span aria-hidden="true" class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-[#1d4ed8] text-[11px] font-bold text-white">✓</span><span><strong>Diterima</strong> — thread Anda sudah tercatat publik.</span></li>
        <li class="flex items-center gap-2"><span aria-hidden="true" class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-[#f59e0b] text-[11px] font-bold text-white">2</span><span><strong>Dijawab admin</strong> — biasanya 1–2 hari kerja.</span></li>
        <li class="flex items-center gap-2"><span aria-hidden="true" class="inline-flex h-5 w-5 items-center justify-center rounded-full border border-[#ebebeb] bg-white text-[11px] font-bold text-[#737373]">3</span><span><strong>Tampil di sini</strong> — pantau halaman ini berkala.</span></li>
      </ol>
      <p class="mt-3 text-[#92400e]">Tips: saat bertanya, isi email (boleh anonim) agar Anda ingat kembali ke thread ini. Sambil menunggu, baca thread terkait di bawah.</p>
    </div>
  )}
</article>
