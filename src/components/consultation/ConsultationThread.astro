---
interface ConsultationReply {
  id: string;
  content: string;
  createdAt: number;
  author?: {
    nama?: string;
    role?: string;
  };
}

interface Consultation {
  id: string;
  title: string;
  content: string;
  category: string;
  status: string;
  createdAt: number;
  isAnonymous: boolean;
  authorName?: string;
  author?: {
    nama?: string;
  };
  replies?: ConsultationReply[];
}

const { consultation } = Astro.props as { consultation: Consultation };
const authorLabel = consultation.isAnonymous ? (consultation.authorName || 'Anonim') : (consultation.author?.nama || 'Pengguna');
---
<article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3 text-sm text-slate-500">
    <span class="font-semibold text-slate-700">{consultation.category}</span>
    <span>{new Date(consultation.createdAt * 1000).toLocaleDateString('id-ID')}</span>
  </div>

  <h2 class="text-xl font-semibold text-slate-900">{consultation.title}</h2>
  <p class="mt-4 text-sm leading-7 text-slate-700">{consultation.content}</p>

  <div class="mt-6 rounded-2xl bg-slate-50 p-4 text-sm text-slate-600">
    <div class="flex items-center justify-between gap-3">
      <span>Ditanyakan oleh: <strong>{authorLabel}</strong></span>
      <span class="rounded-full bg-slate-100 px-3 py-1 text-xs uppercase tracking-wide text-slate-700">{consultation.status}</span>
    </div>
  </div>

  {consultation.replies?.length ? (
    <div class="mt-6 space-y-4">
      <h3 class="text-base font-semibold text-slate-900">Jawaban Admin</h3>
      {consultation.replies.map((reply) => (
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
          <div class="mb-2 flex items-center justify-between gap-3 text-xs uppercase tracking-wide text-slate-500">
            <span>{reply.author?.role === 'admin' ? 'Admin HarumCare' : reply.author?.nama || 'Pengguna'}</span>
            <span>{new Date(reply.createdAt * 1000).toLocaleDateString('id-ID')}</span>
          </div>
          <p class="text-sm leading-7 text-slate-700">{reply.content}</p>
        </div>
      ))}
    </div>
  ) : (
    <div class="mt-6 rounded-2xl bg-amber-50 p-4 text-sm text-amber-900">
      Belum ada jawaban. Admin akan membalas secepatnya.
    </div>
  )}
</article>
