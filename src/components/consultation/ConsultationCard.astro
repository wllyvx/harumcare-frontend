---
const { consultation } = Astro.props;
const authorLabel = consultation.isAnonymous ? (consultation.authorName || 'Anonim') : (consultation.author?.nama || 'Pengguna');
const formatDate = (dateInput: string | number | Date) => {
  try {
    let date: Date;
    if (typeof dateInput === 'string') date = new Date(dateInput);
    else if (typeof dateInput === 'number') date = new Date(dateInput < 1e12 ? dateInput * 1000 : dateInput);
    else date = dateInput;
    return date.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
  } catch (e) {
    return '-';
  }
};
const statusMap: Record<string, { label: string; classes: string }> = {
  open: { label: 'Menunggu jawaban', classes: 'bg-[#fffbeb] text-[#92400e] ring-1 ring-[#f59e0b]/40' },
  waiting: { label: 'Menunggu jawaban', classes: 'bg-[#fffbeb] text-[#92400e] ring-1 ring-[#f59e0b]/40' },
  pending: { label: 'Menunggu jawaban', classes: 'bg-[#fffbeb] text-[#92400e] ring-1 ring-[#f59e0b]/40' },
  answered: { label: 'Sudah dijawab', classes: 'bg-[#dbeafe] text-[#1e3a8a]' },
  closed: { label: 'Sudah dijawab', classes: 'bg-[#dbeafe] text-[#1e3a8a]' },
  resolved: { label: 'Sudah dijawab', classes: 'bg-[#dbeafe] text-[#1e3a8a]' },
};
const statusKey = String(consultation.status || '').toLowerCase();
const status = statusMap[statusKey] || { label: 'Menunggu jawaban', classes: 'bg-[#fffbeb] text-[#92400e] ring-1 ring-[#f59e0b]/40' };
const isAnswered = ['answered', 'closed', 'resolved'].includes(statusKey);
const categoryLabel = String(consultation.category || '').charAt(0).toUpperCase() + String(consultation.category || '').slice(1);
const ctaLabel = isAnswered ? 'Lihat Jawaban' : 'Lihat Thread';
const toISO = (v: string | number | Date) => {
  try {
    let d: Date;
    if (typeof v === 'string') d = new Date(v);
    else if (typeof v === 'number') d = new Date(v < 1e12 ? v * 1000 : v);
    else d = v;
    return isNaN(d.getTime()) ? undefined : d.toISOString();
  } catch { return undefined; }
};
const dateISO = toISO(consultation.createdAt);
---
<article class="group min-w-0 rounded-2xl border border-[#ebebeb] bg-white p-5 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl">
  <div class="flex min-w-0 items-center justify-between gap-3 text-sm text-[#737373]">
    <span class="inline-flex min-h-11 items-center gap-2 font-medium text-[#525252]"><span aria-hidden="true" class="inline-block h-2 w-2 rounded-full bg-[#1d4ed8]"></span>{categoryLabel}<span class="sr-only">, status: {status.label}</span></span>
    <time class="shrink-0" datetime={dateISO}>{formatDate(consultation.createdAt)}</time>
  </div>

  <h3 class="mt-3 text-balance text-lg font-semibold text-[#252525]"><a href={`/pojok-konsultasi/${consultation.id}`} aria-describedby={`cta-${consultation.id}`} class="transition group-hover:text-[#1d4ed8] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600">{consultation.title}</a></h3>
  <p class="mt-2 line-clamp-3 max-w-[68ch] text-sm leading-6 text-[#737373]">{consultation.content}</p>

  <div class="mt-4 flex min-w-0 flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="min-w-0 truncate text-sm text-[#737373]">
      Ditanyakan oleh: <strong class="font-semibold text-[#525252]">{authorLabel}</strong>
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <span class={`inline-flex min-h-11 items-center rounded-full px-3 py-1 text-xs font-semibold tracking-wide ${status.classes}`}>{status.label}</span>
      <span id={`cta-${consultation.id}`} aria-hidden="true" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-[#1d4ed8] px-4 py-2 text-sm font-semibold text-white transition group-hover:bg-[#1e3a8a]">{ctaLabel}</span>
    </div>
  </div>
</article>
