---
import Card from "../common/Card.astro";

interface Props {
  title?: string;
  campaigns: Array<{
    id: number;
    title: string;
    description: string;
    imageUrl: string;
    targetAmount: number;
    currentAmount: number;
    endDate: string;
    donorCount: number;
    organizationName: string;
    organizationLogo: string;
    category: string;
  }>;
  showViewAll?: boolean;
  viewAllLink?: string;
}

const {
  title = "Program Terbaru",
  campaigns = [],
  showViewAll = true,
  viewAllLink = "/campaign",
} = Astro.props;

const today = new Date();
const campaignsWithDaysLeft = campaigns.map((campaign) => {
  const endDate = new Date(campaign.endDate);
  const daysLeft = Math.ceil((endDate.getTime() - today.getTime()) / (1000 * 3600 * 24));
  return { ...campaign, daysLeft: daysLeft >= 0 ? daysLeft : 0 };
});
const featuredCampaigns = campaignsWithDaysLeft.slice(0, 6);
---

<section class="py-12 md:py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-end justify-between gap-4 mb-8">
      <div>
        <h2 class="text-xl md:text-2xl font-bold tracking-tight text-foreground">{title}</h2>
        <p class="text-sm text-muted-foreground mt-1.5">Pilihan kampanye yang membutuhkan dukungan Anda</p>
      </div>
      {showViewAll && featuredCampaigns.length > 0 && (
        <a href={viewAllLink} class="text-sm font-semibold text-brand-700 hover:text-brand-800 shrink-0 hidden sm:inline-flex items-center gap-1.5 underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2 rounded-sm">Lihat semua <span aria-hidden="true">→</span></a>
      )}
    </div>
    {featuredCampaigns.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
        {featuredCampaigns.map((campaign) => (
          <Card
            id={campaign.id}
            title={campaign.title || "Untitled"}
            description={campaign.description || "Tidak ada Deskripsi"}
            imageUrl={campaign.imageUrl}
            targetAmount={campaign.targetAmount}
            currentAmount={campaign.currentAmount || 0}
            daysLeft={campaign.daysLeft}
            donorCount={campaign.donorCount || 0}
            organizationName={campaign.organizationName || "Anonymous"}
            organizationLogo={campaign.organizationLogo}
            category={campaign.category || "Tidak Berkategori"}
          />
        ))}
      </div>
    ) : (
      <div class="rounded-2xl border border-dashed border-border bg-muted/40 py-12 px-6 text-center">
        <p class="text-sm text-muted-foreground">Tidak ada kampanye tersedia saat ini.</p>
        <a href="/campaign" class="mt-4 inline-flex items-center justify-center px-5 py-2.5 bg-brand-700 hover:bg-brand-800 text-white text-sm font-semibold rounded-button transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2">Jelajahi kampanye</a>
      </div>
    )}
    {showViewAll && featuredCampaigns.length > 0 && (
      <div class="mt-8 flex justify-center sm:hidden">
        <a href={viewAllLink} class="inline-flex items-center justify-center gap-1.5 px-5 py-2.5 border border-border bg-white text-sm font-semibold text-foreground rounded-button hover:border-brand-300 hover:text-brand-700 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2">Lihat semua kampanye <span aria-hidden="true">→</span></a>
      </div>
    )}
  </div>
</section>
