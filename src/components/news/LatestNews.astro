---
import NewsCard from "./NewsCard.astro";

interface News {
  _id: string;
  title: string;
  content: string;
  image: string;
  slug: string;
  author?: { nama: string; username: string };
  category: string;
  createdAt: string;
  viewCount: number;
}

interface Props {
  title?: string;
  limit?: number;
  showViewAll?: boolean;
  viewAllLink?: string;
}

const {
  title = "Berita Terbaru",
  limit = 4,
  showViewAll = true,
  viewAllLink = "/news",
} = Astro.props;

let latestNews: News[] = [];
try {
  const response = await fetch(
    `${import.meta.env.PUBLIC_API_URL || "http://localhost:3000/api"}/news/latest?limit=${limit}`,
  );
  if (response.ok) latestNews = await response.json();
} catch {}
---

<section class="py-12 md:py-16 bg-muted border-t border-border/40">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-end justify-between gap-4 mb-8">
      <div>
        <h2 class="text-xl md:text-2xl font-bold tracking-tight text-foreground">{title}</h2>
        <p class="text-sm text-muted-foreground mt-1.5">Cerita terbaru dari lapangan</p>
      </div>
      {showViewAll && latestNews.length > 0 && (
        <a href={viewAllLink} class="text-sm font-medium text-[#1d4ed8] hover:text-[#1e3a8a] shrink-0 hidden sm:inline-flex items-center gap-1">Lihat semua <span aria-hidden="true">→</span></a>
      )}
    </div>
    {latestNews.length > 0 ? (
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 md:gap-6">
        {latestNews.map((news: News) => (
          <NewsCard
            id={news._id}
            title={news.title}
            content={news.content}
            image={news.image}
            slug={news.slug}
            author={news.author}
            category={news.category}
            createdAt={news.createdAt}
            viewCount={news.viewCount}
          />
        ))}
      </div>
    ) : (
      <p class="text-center py-12 text-muted-foreground text-sm">Belum ada berita.</p>
    )}
  </div>
</section>
