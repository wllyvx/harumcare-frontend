---
import NewsCard from "./NewsCard.astro";

interface News {
  _id: string;
  title: string;
  content: string;
  image: string;
  slug: string;
  author?: { nama: string; username: string };
  category: string;
  createdAt: string;
  viewCount: number;
}

interface Props {
  title?: string;
  limit?: number;
  showViewAll?: boolean;
  viewAllLink?: string;
}

const {
  title = "Berita Terbaru",
  limit = 4,
  showViewAll = true,
  viewAllLink = "/news",
} = Astro.props;

let latestNews: News[] = [];
try {
  const response = await fetch(
    `${import.meta.env.PUBLIC_API_URL || "http://localhost:3000/api"}/news/latest?limit=${limit}`,
  );
  if (response.ok) latestNews = await response.json();
} catch {}
---

<section class="py-12 md:py-16 bg-muted/40 border-t border-border/40">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-end justify-between gap-4 mb-8">
      <div>
        <h2 class="text-xl md:text-2xl font-bold tracking-tight text-foreground">{title}</h2>
        <p class="text-sm text-muted-foreground mt-1.5">Cerita terbaru dari lapangan</p>
      </div>
      {showViewAll && latestNews.length > 0 && (
        <a href={viewAllLink} class="text-sm font-semibold text-brand-700 hover:text-brand-800 shrink-0 hidden sm:inline-flex items-center gap-1.5 underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2 rounded-sm">Lihat semua <span aria-hidden="true">→</span></a>
      )}
    </div>
    {latestNews.length > 0 ? (
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 md:gap-6">
        {latestNews.map((news: News) => (
          <NewsCard
            id={news._id}
            title={news.title}
            content={news.content}
            image={news.image}
            slug={news.slug}
            author={news.author}
            category={news.category}
            createdAt={news.createdAt}
            viewCount={news.viewCount}
          />
        ))}
      </div>
    ) : (
      <div class="rounded-2xl border border-dashed border-border bg-white py-12 px-6 text-center">
        <p class="text-sm text-muted-foreground">Belum ada berita.</p>
        <a href="/news" class="mt-4 inline-flex items-center justify-center px-5 py-2.5 bg-white border border-border text-sm font-semibold text-foreground rounded-button hover:border-brand-300 hover:text-brand-700 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2">Lihat semua berita</a>
      </div>
    )}
    {showViewAll && latestNews.length > 0 && (
      <div class="mt-8 flex justify-center lg:hidden">
        <a href={viewAllLink} class="inline-flex items-center justify-center gap-1.5 px-5 py-2.5 border border-border bg-white text-sm font-semibold text-foreground rounded-button hover:border-brand-300 hover:text-brand-700 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2">Lihat semua berita <span aria-hidden="true">→</span></a>
      </div>
    )}
  </div>
</section>
