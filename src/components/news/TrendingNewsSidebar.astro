---
// News interface
interface News {
    id: string;
    title: string;
    image: string;
    slug: string;
    createdAt: string;
}

// Fetch trending news — gagal-cepat 5 dtk seperti next-reads di [slug]
let trendingNews: News[] = [];
const formatSidebarDate = (v: unknown) => {
    if (typeof v !== "string" || !v) return "";
    try {
        const d = new Date(v);
        if (Number.isNaN(d.getTime())) return "";
        return d.toLocaleDateString("id-ID", {
            day: "numeric",
            month: "short",
            year: "numeric",
        });
    } catch {
        return "";
    }
};
try {
    const trendingParams = new URLSearchParams({
        page: "1",
        limit: "5", // Show 5 trending news
        status: "published",
    });

    const API_URL =
        import.meta.env.PUBLIC_API_URL || "http://localhost:3000/api";
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), 5000);
    try {
        const trendingResponse = await fetch(`${API_URL}/news?${trendingParams}`, {
            signal: controller.signal,
        });
        if (trendingResponse.ok) {
            const trendingData = await trendingResponse.json().catch(() => null);
            const raw: unknown = trendingData?.news;
            trendingNews = Array.isArray(raw)
                ? raw.filter(
                      (n): n is News =>
                          !!n &&
                          typeof (n as News).slug === "string" &&
                          typeof (n as News).title === "string",
                  )
                : [];
        }
    } finally {
        clearTimeout(timer);
    }
} catch (error) {
    console.error("Error fetching trending news:", error);
}
---

<div class="bg-white rounded-xl border border-gray-100 p-5 shadow-sm">
    <h2 class="text-base font-bold tracking-tight text-brand-800 mb-4">Berita Terpopuler</h2>
    <div class="space-y-1">
        {
            trendingNews.length > 0 ? (
                trendingNews.map((n) => (
                    <a
                        href={`/news/${n.slug}`}
                        class="flex items-start gap-3 p-2 rounded-lg hover:bg-brand-50 transition-colors group"
                    >
                        <div class="w-16 h-16 flex-shrink-0 overflow-hidden rounded-md border border-gray-100">
                            <img
                                src={
                                    n.image ||
                                    "/images/empty-image-placeholder.webp"
                                }
                                alt=""
                                loading="lazy"
                                decoding="async"
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                onerror="this.src='/images/empty-image-placeholder.webp'"
                            />
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-semibold text-gray-900 line-clamp-2 leading-snug group-hover:text-brand-700 transition-colors">
                                {n.title}
                            </p>
                            <p class="text-xs text-gray-500 mt-1 flex items-center gap-1">
                                <svg
                                    class="w-3 h-3"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                    />
                                </svg>
                                {formatSidebarDate(n.createdAt) || "Tanggal tidak tersedia"}
                            </p>
                        </div>
                    </a>
                ))
            ) : (
                <p class="text-sm text-gray-500 text-center py-4">
                    Belum ada berita terpopuler.
                </p>
            )
        }
    </div>
</div>
