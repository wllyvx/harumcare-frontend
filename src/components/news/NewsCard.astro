---
interface Props {
  id: string;
  title: string;
  content: string;
  image: string;
  slug: string;
  author?: {
    nama: string;
    username: string;
  };
  category: string;
  createdAt: string;
  viewCount: number;
}

const {
  id,
  title,
  content,
  image,
  slug,
  author,
  category,
  createdAt,
  viewCount,
} = Astro.props;

// Format tanggal
const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString("id-ID", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

// Truncate content untuk preview
import { marked } from "marked";

const truncateContent = (text: string, maxLength: number = 150) => {
  if (!text) return "";
  // Parse markdown to HTML then strip tags
  const html = marked.parse(text) as string;
  const plainText = html.replace(/<[^>]*>/g, "");

  if (plainText.length <= maxLength) return plainText;
  return plainText.substring(0, maxLength) + "...";
};
---

<article
  class="bg-white p-4 rounded-2xl flex flex-col sm:flex-row gap-5 md:gap-6 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 group cursor-pointer border border-border"
>
  <a href={`/news/${slug}`} class="contents focus-visible:outline-none">
    <div
      class="w-full sm:w-48 aspect-[4/3] sm:aspect-square shrink-0 bg-cover bg-center rounded-xl overflow-hidden bg-muted"
      style={`background-image: url("${image || "/images/empty-image-placeholder.webp"}");`}
      role="img"
      aria-label={title}
    >
    </div>

    <!-- Content Section -->
    <div class="flex flex-col justify-center py-2 flex-grow">
      <!-- Category -->
      <span
        class="text-xs font-bold text-brand-500 mb-2 uppercase tracking-wide"
      >
        {category}
      </span>

      <h3
        class="text-lg md:text-xl font-semibold mb-2.5 group-hover:text-brand-700 transition-colors line-clamp-2 text-foreground leading-snug"
      >
        {title}
      </h3>

      <p class="text-sm text-muted-foreground mb-4 line-clamp-2 leading-relaxed">
        {truncateContent(content, 120)}
      </p>

      <div class="flex items-center justify-between mt-auto">
        <!-- Date -->
        <span class="text-xs text-gray-400 flex items-center gap-1">
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path>
          </svg>
          {formatDate(createdAt)}
        </span>

        <span
          class="text-sm font-semibold text-brand-700 flex items-center gap-1 group-hover:gap-2 transition-all"
        >
          Baca Selengkapnya
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
