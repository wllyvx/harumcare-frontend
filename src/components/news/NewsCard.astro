---
interface Props {
  id: string;
  title: string;
  content: string;
  image: string;
  slug: string;
  author?: {
    nama: string;
    username: string;
  };
  category: string;
  createdAt: string;
  viewCount: number;
}

const {
  id,
  title,
  content,
  image,
  slug,
  author,
  category,
  createdAt,
  viewCount,
} = Astro.props;

// Format tanggal
const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString("id-ID", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

// Truncate content untuk preview
const truncateContent = (text: string, maxLength: number = 150) => {
  if (text.length <= maxLength) return text;
  return text.substring(0, maxLength) + "...";
};
---

<article
  class="bg-white p-4 rounded-2xl flex flex-col sm:flex-row gap-6 hover:shadow-lg transition-all group cursor-pointer border border-gray-100"
>
  <a href={`/news/${slug}`} class="contents">
    <!-- Image Section -->
    <div
      class="w-full sm:w-48 aspect-square shrink-0 bg-cover bg-center rounded-xl overflow-hidden"
      style={`background-image: url("${image || "/images/empty-image-placeholder.webp"}");`}
    >
    </div>

    <!-- Content Section -->
    <div class="flex flex-col justify-center py-2 flex-grow">
      <!-- Category -->
      <span
        class="text-xs font-bold text-brand-500 mb-2 uppercase tracking-wide"
      >
        {category}
      </span>

      <!-- Title -->
      <h3
        class="text-xl font-bold mb-3 group-hover:text-brand-600 transition-colors line-clamp-2 text-gray-900"
      >
        {title}
      </h3>

      <!-- Content Preview -->
      <p class="text-sm text-gray-500 mb-4 line-clamp-2">
        {truncateContent(content, 120)}
      </p>

      <div class="flex items-center justify-between mt-auto">
        <!-- Date -->
        <span class="text-xs text-gray-400 flex items-center gap-1">
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path>
          </svg>
          {formatDate(createdAt)}
        </span>

        <!-- Read More Link -->
        <span
          class="text-sm font-bold text-brand-600 flex items-center gap-1 group-hover:gap-2 transition-all"
        >
          Baca Selengkapnya
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
