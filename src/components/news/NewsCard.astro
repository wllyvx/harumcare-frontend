---
interface Props {
  id: string;
  title: string;
  content: string;
  image: string;
  slug: string;
  author?: {
    nama: string;
    username: string;
  };
  category: string;
  createdAt: string;
  viewCount: number;
}

const {
  id,
  title,
  content,
  image,
  slug,
  author,
  category,
  createdAt,
  viewCount,
} = Astro.props;

// Format tanggal
const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString("id-ID", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

// Truncate content untuk preview
const truncateContent = (text: string, maxLength: number = 150) => {
  if (text.length <= maxLength) return text;
  return text.substring(0, maxLength) + "...";
};
---

<article
  class="news-card-compact group cursor-pointer transition-all duration-300 hover:shadow-2xl bg-white rounded-xl md:rounded-2xl lg:rounded-4xl overflow-hidden border border-gray-100"
>
  <a href={`/news/${slug}`} class="flex p-5 gap-5 sm:gap-7 h-full items-center">
    <!-- Image Section -->
    <div
      class="news-image-container-compact shrink-0 w-28 h-28 sm:w-36 sm:h-36 lg:w-44 lg:h-44 relative rounded-xl md:rounded-2xl lg:rounded-4xl overflow-hidden shadow-sm"
    >
      <img
        src={image || "/images/empty-image-placeholder.webp"}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        onerror="console.error('Failed to load image:', this.src)"
      />
    </div>

    <!-- Content Section -->
    <div
      class="news-content-compact flex flex-col justify-center min-w-0 grow pr-2"
    >
      <!-- Category -->
      <span
        class="text-[10px] sm:text-xs font-bold text-brand-500 uppercase tracking-widest mb-2 sm:mb-3 block"
      >
        {category}
      </span>

      <!-- Title -->
      <h3
        class="text-base sm:text-lg lg:text-2xl font-bold text-gray-900 mb-2 sm:mb-4 leading-tight group-hover:text-brand-600 transition-colors duration-300 line-clamp-2"
      >
        {title}
      </h3>

      <!-- Content Preview -->
      <p
        class="line-clamp-2 sm:line-clamp-2 text-sm text-gray-400 mb-4 sm:mb-6 leading-relaxed"
      >
        {truncateContent(content, 60)}
      </p>

      <div class="flex items-center justify-between gap-4 mt-auto">
        <!-- Date -->
        <div class="flex items-center gap-2 text-gray-400">
          <svg
            class="w-4 h-4 sm:w-5 sm:h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path>
          </svg>
          <span class="text-xs sm:text-sm font-medium">
            {formatDate(createdAt)}
          </span>
        </div>

        <!-- Read More Button -->
        <span
          class="inline-flex items-center gap-1.5 text-brand-600 group-hover:text-brand-700 font-bold text-xs sm:text-sm lg:text-base transition-colors duration-300 whitespace-nowrap"
        >
          Baca Selengkapnya
          <svg
            class="w-3 h-3 sm:w-4 sm:h-4 transition-transform duration-300 group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .news-card-compact {
    width: 100%;
  }

  /* Memastikan link tidak memiliki underline default */
  .news-card-compact a {
    text-decoration: none;
    color: inherit;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
